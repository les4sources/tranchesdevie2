.adm-card.overflow-hidden
  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th = show_future ? "Jour" : "Date"
          th Commandes
          th Capacité
          th Artisans
          th Points de retrait
          th
      tbody
        - bake_days.each do |bake_day|
          tr
            td.whitespace-nowrap.font-semibold style="color: var(--text-strong);"
              = link_to "#{l(bake_day.baked_on, format: '%A').capitalize} #{bake_day.baked_on.strftime('%d/%m/%Y')}",
                        admin_bake_day_path(bake_day),
                        class: "hover:underline"
              - if bake_day.baked_on == Date.current
                span.ml-2 = adm_chip "Aujourd'hui", tone: :success
              - elsif bake_day.baked_on == Date.tomorrow
                span.ml-2 = adm_chip "Demain", tone: :warning
              - if bake_day.market_day?
                span.ml-2 = adm_chip "Marché", tone: :accent
              / Brouillon (#197) : ce jour ne compte nulle part, il faut que ça
              / se voie dès la liste — sinon on cherche un CA qui n'existe pas.
              - if bake_day.draft?
                span.ml-2 = adm_chip "Brouillon", tone: :warning
            td.adm-grid-num
              = link_to bake_day.orders.count, admin_orders_path(bake_day_id: bake_day.id), class: "adm-link"
            td
              - pct = BakeCapacityService.new(bake_day).fill_percentage
              - tone = adm_usage_tone(pct)
              .flex.items-center.gap-2
                span.w-16.flex-none = adm_meter(pct, tone: tone)
                span.adm-grid-num.adm-tonetext.text-xs.font-semibold class="adm-tone-#{tone}"
                  | #{pct}%
            td
              - if bake_day.baking_artisans.any?
                = bake_day.baking_artisans.map(&:name).join(", ")
              - else
                span style="color: var(--text-faint);" —
            td
              - locations = bake_day.pickup_locations.reject(&:deleted_at).sort_by { |l| [ l.position || 0, l.name ] }
              - if locations.any?
                = locations.map(&:name).join(", ")
              - else
                span style="color: var(--text-faint);" —
            td.whitespace-nowrap.text-right
              = link_to "Modifier", edit_admin_bake_day_path(bake_day), class: "adm-rowaction"
