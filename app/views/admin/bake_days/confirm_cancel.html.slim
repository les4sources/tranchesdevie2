- content_for :title, "Annuler la fournée du #{@bake_day.baked_on.strftime('%d/%m/%Y')}"
- content_for :layout, "admin"
- expected_date = @bake_day.baked_on.strftime("%d/%m/%Y")

.mx-auto.max-w-2xl.space-y-6
  div
    = link_to admin_bake_day_path(@bake_day), class: "adm-link inline-flex items-center gap-1 text-sm font-semibold"
      | ← Retour à la fournée
    h1.tdv-script.mt-2.text-3xl
      | Annuler la fournée du #{expected_date}
    p.mt-1.text-sm style="color: var(--text-muted);"
      | Cette action est irréversible : elle rembourse les clients (carte ou portefeuille) et les prévient par SMS.

  - if @preview.any_orders?
    .adm-card.p-5.sm:p-6 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.adm-eyebrow style="color: var(--danger-700);" Impact de l'annulation
      dl.mt-4.grid.gap-4.sm:grid-cols-2
        .adm-card.p-4
          dt.text-sm style="color: var(--text-muted);" Commandes impactées
          dd.adm-grid-num.mt-1.text-2xl.font-bold style="color: var(--text-strong);" = @preview.orders_count
        .adm-card.p-4
          dt.text-sm style="color: var(--text-muted);" Montant total à rembourser
          dd.adm-grid-num.mt-1.text-2xl.font-bold style="color: var(--danger-700);"
            = number_to_currency(@preview.refund_euros, unit: "€", separator: ",", delimiter: " ", format: "%n %u")
        .adm-card.p-4
          dt.text-sm style="color: var(--text-muted);" SMS envoyés aux clients
          dd.adm-grid-num.mt-1.text-2xl.font-bold style="color: var(--text-strong);" = @preview.sms_count

      .adm-card.mt-4.p-4
        p.text-sm.font-semibold style="color: var(--text-strong);" Ventilation par mode
        dl.mt-3.space-y-2.text-sm
          .flex.items-center.justify-between
            dt style="color: var(--text-body);"
              | Carte (Stripe)
              span.ml-1 style="color: var(--text-faint);" = "· #{@preview.stripe_count} commande#{'s' if @preview.stripe_count > 1}"
            dd.adm-grid-num.font-semibold style="color: var(--text-strong);"
              = number_to_currency(@preview.stripe_euros, unit: "€", separator: ",", delimiter: " ", format: "%n %u")
          .flex.items-center.justify-between
            dt style="color: var(--text-body);"
              | Portefeuille
              span.ml-1 style="color: var(--text-faint);" = "· #{@preview.wallet_count} commande#{'s' if @preview.wallet_count > 1}"
            dd.adm-grid-num.font-semibold style="color: var(--text-strong);"
              = number_to_currency(@preview.wallet_euros, unit: "€", separator: ",", delimiter: " ", format: "%n %u")
          .flex.items-center.justify-between
            dt style="color: var(--text-body);"
              | Non encaissé en ligne
              span.ml-1 style="color: var(--text-faint);" = "· #{@preview.non_online_count} commande#{'s' if @preview.non_online_count > 1}"
            dd.font-semibold style="color: var(--text-strong);" —
        - if @preview.manual_refund_count.positive?
          p.mt-3.text-xs style="color: var(--warning-700);"
            | Dont #{@preview.manual_refund_count} payée#{'s' if @preview.manual_refund_count > 1} hors-ligne : remboursement à effectuer à la main.

    = form_with url: cancel_admin_bake_day_path(@bake_day), method: :post, data: { controller: "cancel-guard", "cancel-guard-expected-value": expected_date } do |form|
      .adm-card.mt-6.p-5.sm:p-6
        label.adm-eyebrow.block for="cancel-guard-input"
          | Pour confirmer, retapez la date de la fournée (#{expected_date})
        = text_field_tag :confirmation, nil, id: "cancel-guard-input", autocomplete: "off", placeholder: "JJ/MM/AAAA", class: adm_field_class("mt-2"), data: { "cancel-guard-target": "input", action: "input->cancel-guard#validate" }
        .mt-5.flex.flex-wrap.items-center.gap-3
          button class=adm_btn_class(:danger, "disabled:cursor-not-allowed disabled:opacity-40") type="submit" data-cancel-guard-target="submit"
            | Annuler définitivement la fournée
          = link_to "Ne rien faire", admin_bake_day_path(@bake_day), class: adm_btn_class(:default)
  - else
    .adm-card.p-6.text-center
      p style="color: var(--text-body);" Aucune commande annulable pour cette fournée.
      = link_to "Retour à la fournée", admin_bake_day_path(@bake_day), class: adm_btn_class(:default, "mt-4")
