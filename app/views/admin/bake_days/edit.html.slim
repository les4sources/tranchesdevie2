- content_for :title, "Modifier le jour de cuisson"
- content_for :layout, "admin"

= adm_page_header "Modifier le jour de cuisson"

- if @bake_day.errors.any?
  .adm-card.mb-4.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
    h2.text-sm.font-semibold style="color: var(--danger-700);" Veuillez corriger les erreurs suivantes :
    ul.mt-2.list-disc.space-y-1.pl-5.text-sm style="color: var(--danger-700);"
      - @bake_day.errors.full_messages.each do |msg|
        li = msg

.adm-card.p-4.sm:p-6
  = form_with model: @bake_day, url: admin_bake_day_path(@bake_day), local: true, data: { controller: "bake-day-cutoff" } do |f|
    = render "form_fields", f: f, bake_day: @bake_day, cut_off_hint: false

    .flex.flex-wrap.items-center.gap-3
      = f.submit "Mettre à jour le jour de cuisson", class: adm_btn_class(:primary)
      = link_to "Annuler", admin_bake_day_path(@bake_day), class: adm_btn_class(:ghost)
