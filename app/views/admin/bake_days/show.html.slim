- content_for :title, "Jour de cuisson #{@bake_day.baked_on.strftime('%d/%m/%Y')}"
- content_for :layout, "admin"

- kpis = @dashboard.kpis
- mold_requirements = @dashboard.breads_mold_requirements
- capacity = @dashboard.capacity_service
- capacity_usage = capacity.usage
- status_distribution = @dashboard.status_distribution
- note_input_id = dom_id(@bake_day, :internal_note)

.space-y-4.sm:space-y-6
  .flex.flex-col.gap-4.lg:flex-row.lg:items-start.lg:justify-between
    div.min-w-0
      p.adm-eyebrow Jour de cuisson
      .mt-1.flex.flex-wrap.items-center.gap-2.sm:gap-3
        h1.tdv-script.text-3xl.break-words
          | Fournée du #{@bake_day.baked_on.strftime("%d/%m/%Y")}
        = adm_chip(@bake_day.cut_off_passed? ? "Commandes closes" : "Commandes ouvertes", tone: @bake_day.cut_off_passed? ? :danger : :success)
        - if @bake_day.market_day?
          = adm_chip "Jour de marché", tone: :accent
      p.mt-1.text-sm style="color: var(--text-muted);"
        | Clôture le #{@bake_day.cut_off_at.strftime("%d/%m/%Y à %H:%M")}
    .flex.flex-wrap.gap-2.shrink-0 data-controller="dashboard-export" data-export-payload="#{kpis[:orders_count]} orders / #{kpis[:items_count]} items"
      = link_to "Modifier", edit_admin_bake_day_path(@bake_day), class: adm_btn_class(:default)
      = link_to "Feuille compta", sheet_admin_bake_day_path(@bake_day), class: adm_btn_class(:default)
      button class=adm_btn_class(:default) type="button" data-action="dashboard-export#print"
        | Imprimer la feuille
      = link_to "Annuler la fournée", confirm_cancel_admin_bake_day_path(@bake_day), class: adm_btn_class(:default)
      = button_to "Supprimer", admin_bake_day_path(@bake_day), method: :delete, form: { data: { turbo_confirm: "Supprimer ce jour de cuisson ? Cette action est définitive." } }, class: adm_btn_class(:danger)

  .grid.gap-4.lg:grid-cols-3
    .lg:col-span-2.adm-card.p-4.sm:p-6
      .flex.items-center.justify-between.gap-3
        h2.text-xl.font-semibold style="color: var(--text-strong);" Consignes du jour
        p.adm-tonetext.text-xs.font-medium data-bake-day-note-target="status"
          | Dernière mise à jour #{l(@bake_day.updated_at, format: :short)}
      .mt-4
        = form_with model: @bake_day, url: admin_bake_day_path(@bake_day), method: :patch, html: { class: "space-y-4", data: { controller: "bake-day-note", turbo: false, "bake-day-note-url-value": admin_bake_day_path(@bake_day), "bake-day-note-target": "form" } } do |form|
          = form.hidden_field :internal_note, id: note_input_id
          trix-editor class="trix-content adm-trix" input=note_input_id data-action="trix-change->bake-day-note#queueSave"
          .mt-2.flex.items-center.justify-between.gap-3.text-xs style="color: var(--text-muted);"
            span Partagez les consignes d'approvisionnement, allergies, retards, etc.
            button class=adm_btn_class(:default) type="button" data-action="bake-day-note#save"
              | Enregistrer maintenant

    .lg:col-span-1.min-w-0.adm-card.p-4.sm:p-6
      h2.text-xl.font-semibold style="color: var(--text-strong);" Statut des commandes
      dl.mt-4.space-y-4
        .flex.items-center.justify-between
          dt.text-sm style="color: var(--text-muted);" Commandes en attente
          dd.adm-grid-num.text-base.font-semibold style="color: var(--warning-700);" = kpis[:open_orders]
        .flex.items-center.justify-between
          dt.text-sm style="color: var(--text-muted);" Commandes prêtes / récupérées
          dd.adm-grid-num.text-base.font-semibold style="color: var(--success-700);" = kpis[:ready_orders]
        div
          dt.text-sm style="color: var(--text-muted);" Répartition des statuts
          dd.mt-2.space-y-1
            - status_distribution.each do |status, count|
              .flex.items-center.justify-between.text-sm
                span = adm_order_status_chip(status)
                span.adm-grid-num.font-semibold style="color: var(--text-strong);" = count

  / Pizza parties dont les pâtons se pétrissent sur CETTE fournée (#170). Ce
  / n'est pas toujours le jour même : une party de midi, ou un jour sans
  / fournée, se prépare la fournée d'avant.
  - parties = @dashboard.parties_to_prepare
  - if parties.any?
    .adm-card.p-4.sm:p-6 style="background: var(--accent-tint); border-color: var(--ember-200);"
      .flex.flex-wrap.items-center.gap-3
        h2.text-sm.font-semibold style="color: var(--text-strong);" Pizza parties à préparer
        = adm_chip(pluralize(parties.size, "party", "parties"), tone: :accent)
      p.mt-1.text-sm style="color: var(--text-muted);"
        | Ces pâtons se pétrissent aujourd'hui. Ils comptent dans le pétrin et la farine, pas dans le four.

      .mt-4.overflow-x-auto
        table.adm-grid
          thead
            tr
              th Quand
              th Créneau
              th.text-right Personnes
              th Client
              th
          tbody
            - parties.each do |party|
              tr
                td.whitespace-nowrap
                  - if party[:same_day]
                    = adm_chip "Aujourd'hui", tone: :success
                  - else
                    span style="color: var(--text-strong);"
                      | à préparer pour le #{l(party[:held_on], format: :long_with_day)}
                td.whitespace-nowrap = party[:slot_label]
                td.adm-grid-num.whitespace-nowrap.text-right.font-semibold style="color: var(--text-strong);"
                  = party[:paton_count]
                td = party[:customer_name] || "—"
                td.whitespace-nowrap.text-right
                  = link_to "Voir la commande", admin_order_path(party[:order]), class: "adm-rowaction"

  .adm-card.p-4.sm:p-6
    h2.text-xl.font-semibold style="color: var(--text-strong);" Qui boulange aujourd'hui ?
    = form_with model: @bake_day, url: admin_bake_day_path(@bake_day), method: :patch, local: true, class: "mt-4 space-y-3" do |form|
      .flex.flex-wrap.gap-2
        = form.collection_check_boxes :baking_artisan_ids, Artisan.active.order(:name), :id, :name do |b|
          label.adm-option.flex.cursor-pointer.items-center.gap-2.rounded-md.px-3.py-2 style="border: 1px solid var(--border-subtle);"
            = b.check_box style: "accent-color: var(--brand);"
            span.text-sm.font-medium style="color: var(--text-body);" = b.text
      button class=adm_btn_class(:default) type="submit"
        | Enregistrer

  - kpi_cards = [ \
      { label: "Commandes confirmées", value: kpis[:orders_count], meta: "#{pluralize(kpis[:open_orders], 'commande')} en attente" },
      { label: "Articles à produire", value: kpis[:items_count], meta: "Total des unités à préparer" },
      { label: "Chiffre d'affaires", value: number_to_currency(kpis[:revenue_cents] / 100.0, unit: '€', separator: ',', delimiter: ' '), meta: "Montant TTC" },
      { label: "Variantes concernées", value: kpis[:variants_count], meta: "Produits à vérifier en stock" } \
    ]

  .grid.gap-4.grid-cols-1.sm:grid-cols-2.xl:grid-cols-4
    - kpi_cards.each do |card|
      .adm-card.p-4
        p.adm-eyebrow = card[:label]
        p.adm-grid-num.mt-2.text-2xl.font-semibold style="color: var(--text-strong);" = card[:value]
        p.mt-1.text-xs style="color: var(--text-muted);" = card[:meta]

  - fill_pct = capacity.fill_percentage
  - fill_tone = adm_usage_tone(fill_pct)
  .adm-card.p-4.sm:p-6 style="background: var(--brand-tint); border-color: var(--sage-200);"
    .flex.flex-wrap.items-center.gap-3
      h2.text-xl.font-semibold style="color: var(--text-strong);" Capacité de production
      = adm_chip("#{fill_pct}%", tone: fill_tone)

    .mt-4.space-y-4.sm:mt-6
      h3.adm-eyebrow style="color: var(--text-body);" Moules
      .grid.gap-3.grid-cols-2.sm:grid-cols-3.lg:grid-cols-5
        - capacity_usage[:molds].each do |entry|
          - pct = entry[:limit] > 0 ? (entry[:used].to_f / entry[:limit] * 100).round : 0
          - tone = adm_usage_tone(pct)
          .adm-card.p-3
            p.text-xs.font-semibold style="color: var(--text-strong);" = entry[:mold_type].name
            p.adm-grid-num.mt-1.text-xl.font-bold style="color: var(--text-strong);"
              = entry[:used]
              span.text-xs.font-normal style="color: var(--text-muted);" = " / #{entry[:limit]}"
            .mt-2 = adm_meter(pct, tone: tone)
            p.adm-tonetext.mt-1.text-xs.font-semibold class="adm-tone-#{tone}" = "#{pct}%"
            - if entry[:separate_tracking].present? && entry[:separate_tracking].any?
              .mt-2.space-y-0.5.border-t.pt-2 style="border-color: var(--border-subtle);"
                - entry[:separate_tracking].each do |sep|
                  p.text-xs.font-medium style="color: var(--text-muted);"
                    = "dont #{sep[:variant].name} : #{sep[:qty]}"
        - if mold_requirements[:unassigned] > 0
          .adm-card.p-3 style="border-color: var(--warning-200); background: var(--warning-100);"
            p.text-xs.font-semibold style="color: var(--warning-700);" Non assignés
            p.adm-grid-num.mt-1.text-xl.font-bold style="color: var(--warning-700);" = mold_requirements[:unassigned]

      - if capacity_usage[:kneader].any?
        h3.adm-eyebrow style="color: var(--text-body);" Pétrin
        .grid.gap-3.grid-cols-2.sm:grid-cols-3
          - capacity_usage[:kneader].each do |entry|
            - pct = entry[:limit] > 0 ? (entry[:used].to_f / entry[:limit] * 100).round : 0
            - tone = adm_usage_tone(pct)
            .adm-card.p-3
              p.text-xs.font-semibold style="color: var(--text-strong);" = entry[:flour].name
              p.adm-grid-num.mt-1.text-xl.font-bold style="color: var(--text-strong);"
                = "#{(entry[:used] / 1000.0).round(1)} kg"
                span.text-xs.font-normal style="color: var(--text-muted);" = " / #{(entry[:limit] / 1000.0).round(1)} kg"
              .mt-2 = adm_meter(pct, tone: tone)
              p.adm-tonetext.mt-1.text-xs.font-semibold class="adm-tone-#{tone}" = "#{pct}%"

      h3.adm-eyebrow style="color: var(--text-body);" Four
      - oven = capacity_usage[:oven]
      - oven_pct = oven[:limit] > 0 ? (oven[:used].to_f / oven[:limit] * 100).round : 0
      - oven_tone = adm_usage_tone(oven_pct)
      .grid.gap-3.grid-cols-1.sm:grid-cols-2
        .adm-card.p-3
          p.text-xs.font-semibold style="color: var(--text-strong);"
            | Capacité four
            - if @bake_day.market_day?
              span.ml-1.text-xs.font-normal style="color: var(--accent);" (marché)
          p.adm-grid-num.mt-1.text-xl.font-bold style="color: var(--text-strong);"
            = "#{(oven[:used] / 1000.0).round(1)} kg"
            span.text-xs.font-normal style="color: var(--text-muted);" = " / #{(oven[:limit] / 1000.0).round(1)} kg"
          .mt-2 = adm_meter(oven_pct, tone: oven_tone)
          p.adm-tonetext.mt-1.text-xs.font-semibold class="adm-tone-#{oven_tone}" = "#{oven_pct}%"

  .adm-card.overflow-hidden
    .adm-cardhd
      div
        h2.text-xl.font-semibold style="color: var(--text-strong);" Quantités de pâte requises par type de farine
        p.text-xs style="color: var(--text-muted);" Survolez une quantité pour voir le détail du calcul
    .overflow-x-auto
      table.adm-grid
        thead
          tr
            th Type de farine / Produit
            th.text-right Quantité de pâte
        tbody
          - if @dashboard.flour_type_stats.any?
            - @dashboard.flour_type_stats.each do |stat|
              - products = stat[:products] || []
              tr style="background: var(--surface-inset);"
                td
                  p.font-semibold style="color: var(--text-strong);" = stat[:flour].name
                td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);" data-controller="dough-tooltip"
                  span.adm-popover-trigger data-dough-tooltip-target="trigger"
                    | #{stat[:flour_quantity]} g
                  .adm-popover.invisible.opacity-0.scale-95.pointer-events-none.fixed.z-50.w-72.origin-top-right.transition-all.duration-150.ease-out data-dough-tooltip-target="popover"
                    .px-3.pt-3.pb-2
                      .mb-2.flex.items-center.justify-between
                        span.text-xs.font-semibold style="color: var(--text-strong);" = stat[:flour].name
                        span.adm-grid-num.text-xs.font-bold style="color: var(--accent);" = "#{stat[:flour_quantity]} g"
                      .space-y-1
                        - products.each do |pd|
                          .flex.items-center.justify-between.text-xs
                            span.mr-3.truncate style="color: var(--text-muted);" = pd[:product].name
                            span.adm-grid-num.font-medium.whitespace-nowrap style="color: var(--text-body);" = "#{pd[:flour_quantity]} g"
              - if products.any?
                - products.each do |product_detail|
                  - details = product_detail[:order_details] || []
                  tr
                    td.pl-8
                      p.text-sm style="color: var(--text-body);" = product_detail[:product].name
                    td.adm-grid-num.text-right.text-sm style="color: var(--text-body);" data-controller="dough-tooltip"
                      span.adm-popover-trigger data-dough-tooltip-target="trigger"
                        | #{product_detail[:flour_quantity]} g
                      .adm-popover.invisible.opacity-0.scale-95.pointer-events-none.fixed.z-50.origin-top-right.transition-all.duration-150.ease-out data-dough-tooltip-target="popover" style="width: max-content; min-width: 20rem; max-width: 28rem"
                        .px-3.pt-3.pb-1
                          .mb-2.flex.items-center.justify-between
                            span.text-xs.font-semibold style="color: var(--text-strong);" = product_detail[:product].name
                            span.adm-grid-num.text-xs.font-bold style="color: var(--accent);" = "#{product_detail[:flour_quantity]} g"
                        .max-h-52.overflow-y-auto
                          - details.each_with_index do |d, idx|
                            .flex.items-baseline.gap-2.px-3.py-1.5.text-xs style=(idx.even? ? "background: var(--surface-inset);" : nil)
                              .flex.items-center.gap-1.5.shrink-0
                                = dough_tooltip_dot(d[:status])
                                span.adm-grid-num style="color: var(--text-muted);" = d[:order_number]&.sub(/^TV-\d{4}/, '…')
                              .adm-grid-num.ml-auto.text-right.whitespace-nowrap style="color: var(--text-body);"
                                - if d[:percentage] == 100
                                  | #{d[:qty]} × #{d[:flour_qty_per_unit]} g
                                - else
                                  | #{d[:qty]} × #{d[:flour_qty_per_unit]} g × #{d[:percentage]}%
                                span.ml-1.font-semibold style="color: var(--text-strong);"
                                  | = #{d[:contribution]} g
                        .flex.items-center.justify-between.border-t.px-3.py-2.text-xs style="border-color: var(--border-subtle);"
                          span style="color: var(--text-muted);" = "#{details.size} commande#{'s' if details.size > 1}"
                          span.adm-grid-num.font-bold style="color: var(--text-strong);" = "#{product_detail[:flour_quantity]} g"
            tr.adm-grid-total
              td Quantité totale de pâte
              td.adm-grid-num.text-right
                | #{@dashboard.total_flour_quantity} g
          - else
            = adm_empty_row(colspan: 2, title: "Aucune quantité de farine requise pour l'instant.", hint: "Les quantités apparaissent dès qu'une commande porte un produit associé à une farine.")

  - dough_data = @dashboard.dough_quantities
  - if dough_data[:per_flour].any?
    .adm-card.overflow-hidden
      .adm-cardhd
        div
          h2.text-xl.font-semibold style="color: var(--text-strong);" Panification
          p.text-xs style="color: var(--text-muted);" Farine, sel, eau et levain calculés à partir des ratios de panification — chacun en fraction de la pâte
      .overflow-x-auto
        table.adm-grid
          thead
            tr
              th
              - dough_data[:per_flour].each do |col|
                th.text-right
                  = col[:flour].name
                  span.block.font-normal.normal-case style="color: var(--text-faint); font-size: 10px;" = "levain #{col[:levain_type]}"
              th.text-right TOTAL
          tbody
            tr style="background: var(--surface-sunk);"
              td.font-semibold style="color: var(--text-strong);" Quantité pâte (kg)
              - dough_data[:per_flour].each do |col|
                td.adm-grid-num.text-right style="color: var(--text-body);"
                  = number_with_precision(col[:pate_kg], precision: 2, strip_insignificant_zeros: true)
              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                = number_with_precision(dough_data[:totals][:pate_kg], precision: 2, strip_insignificant_zeros: true)
            tr style="background: var(--surface-inset);"
              td.font-semibold style="color: var(--text-strong);" Farine (kg)
              - dough_data[:per_flour].each do |col|
                td.adm-grid-num.text-right style="color: var(--text-body);"
                  = number_with_precision(col[:farine_kg], precision: 2, strip_insignificant_zeros: true)
              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                = number_with_precision(dough_data[:totals][:farine_kg], precision: 2, strip_insignificant_zeros: true)
            tr
              td.font-semibold style="color: var(--text-strong);" Sel (kg)
              - dough_data[:per_flour].each do |col|
                td.adm-grid-num.text-right style="color: var(--text-body);"
                  = number_with_precision(col[:sel_kg], precision: 3, strip_insignificant_zeros: true)
              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                = number_with_precision(dough_data[:totals][:sel_kg], precision: 3, strip_insignificant_zeros: true)
            tr style="background: var(--surface-inset);"
              td.font-semibold style="color: var(--text-strong);" Eau (l)
              - dough_data[:per_flour].each do |col|
                td.adm-grid-num.text-right style="color: var(--text-body);"
                  = number_with_precision(col[:eau_l], precision: 2, strip_insignificant_zeros: true)
              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                = number_with_precision(dough_data[:totals][:eau_l], precision: 2, strip_insignificant_zeros: true)
            tr
              td.font-semibold style="color: var(--text-strong);" Levain (kg)
              - dough_data[:per_flour].each do |col|
                td.adm-grid-num.text-right style="color: var(--text-body);"
                  = number_with_precision(col[:levain_kg], precision: 3, strip_insignificant_zeros: true)
              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                = number_with_precision(dough_data[:totals][:levain_kg], precision: 3, strip_insignificant_zeros: true)
      - if dough_data[:levain_by_type].present?
        .flex.flex-wrap.items-center.gap-x-4.gap-y-1.border-t.px-3.py-2.text-xs style="border-color: var(--border-subtle); color: var(--text-muted);"
          span.adm-eyebrow Type de levain
          - dough_data[:levain_by_type].each do |levain_type, kg|
            span
              | Levain #{levain_type} :
              span.adm-grid-num.ml-1.font-semibold style="color: var(--text-body);" = "#{number_with_precision(kg, precision: 3, strip_insignificant_zeros: true)} kg"

  .adm-card.overflow-hidden
    .adm-cardhd
      h2.text-xl.font-semibold style="color: var(--text-strong);" Ingrédients requis
    .overflow-x-auto
      table.adm-grid
        thead
          tr
            th Ingrédient
            th.text-right Quantité totale
        tbody
          - if @dashboard.ingredient_stats.any?
            - @dashboard.ingredient_stats.each do |stat|
              - ingredient = stat[:ingredient]
              - total = stat[:total]
              tr
                td
                  p.font-semibold style="color: var(--text-strong);" = ingredient.name
                td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                  - if ingredient.weight?
                    - if total >= 1000
                      | #{number_with_precision(total / 1000.0, precision: 2, strip_insignificant_zeros: true)} kg
                    - else
                      | #{total.round(0)} g
                  - else
                    | #{total.round(0)} pièce(s)
          - else
            = adm_empty_row(colspan: 2, title: "Aucun ingrédient requis pour l'instant.", hint: "Les ingrédients apparaissent dès qu'un produit commandé en déclare.")

  .adm-card.p-4.sm:p-6 data-controller="dashboard-tabs" data-dashboard-tabs-active-value="clients"
    .overflow-x-auto
      .flex.flex-nowrap.items-center.gap-2.border-b.pb-4.sm:flex-wrap.min-w-max.sm:min-w-0 style="border-color: var(--border-subtle);"
        button.adm-tab type="button" data-dashboard-tabs-target="tab" data-tab="clients" data-action="dashboard-tabs#show"
          | Commandes par client
        button.adm-tab type="button" data-dashboard-tabs-target="tab" data-tab="products" data-action="dashboard-tabs#show"
          | Articles & variantes
        button.adm-tab type="button" data-dashboard-tabs-target="tab" data-tab="timeline" data-action="dashboard-tabs#show"
          | Flux des commandes
        button.adm-tab type="button" data-dashboard-tabs-target="tab" data-tab="pickup" data-action="dashboard-tabs#show"
          | Par point de retrait
        button.adm-tab type="button" data-dashboard-tabs-target="tab" data-tab="flags" data-action="dashboard-tabs#show"
          | Drapeaux

    / Répartition par point de retrait (#148) : commandes + récapitulatif agrégé
    / des articles pour chaque lieu, et la feuille d'émargement PDF à imprimer.
    .mt-6.hidden data-dashboard-tabs-target="panel" data-panel="pickup"
      - if @dashboard.pickup_location_breakdown.any?
        .space-y-6
          - @dashboard.pickup_location_breakdown.each do |entry|
            - location = entry[:pickup_location]
            .adm-card.overflow-hidden
              .adm-cardhd.flex-wrap
                div
                  p.font-semibold style="color: var(--text-strong);"
                    = location.name
                    - if location.deleted_at.present?
                      span.ml-2 = adm_chip "Lieu supprimé", tone: :warning
                  - if location.description.present?
                    p.text-xs style="color: var(--text-muted);" = location.description
                  / `pluralize` n'accorde pas en locale fr (aucune règle d'inflexion
                  / française) : on passe le pluriel explicitement.
                  p.mt-1.text-xs style="color: var(--text-muted);"
                    = "#{pluralize(entry[:orders_count], 'commande', 'commandes')} · #{number_to_currency(entry[:total_cents] / 100.0, unit: '€', format: '%n %u')}"
                = link_to pickup_sheet_admin_bake_day_path(@bake_day, pickup_location_id: location.id), class: adm_btn_class(:primary)
                  | Feuille de retrait (PDF)

              - if entry[:orders].any?
                .grid.grid-cols-1.gap-4.p-4.lg:grid-cols-2
                  / Récapitulatif agrégé : ce qui permet de répartir les produits.
                  div
                    p.adm-eyebrow.mb-2 Articles à préparer pour ce lieu
                    .overflow-x-auto.overflow-hidden style="border: 1px solid var(--border-subtle); border-radius: var(--radius-md);"
                      table.adm-grid
                        thead
                          tr
                            th Article
                            th.text-right Quantité
                        tbody
                          - entry[:variant_stats].each do |stat|
                            tr
                              td
                                | #{stat[:product].name} (#{stat[:variant].name})
                              td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);" = stat[:units_count]

                  / Détail des commandes du lieu.
                  div
                    p.adm-eyebrow.mb-2 Commandes
                    .space-y-2
                      - entry[:orders].each do |order|
                        .rounded-md.p-3 style="border: 1px solid var(--border-subtle);"
                          .flex.items-start.justify-between.gap-3
                            div
                              p.text-sm.font-semibold style="color: var(--text-strong);" = order.customer.full_name
                              p.adm-grid-num.text-xs style="color: var(--text-muted);" = order.order_number
                            p.adm-grid-num.text-sm.font-semibold.whitespace-nowrap style="color: var(--text-strong);"
                              = number_to_currency(order.total_cents / 100.0, unit: "€", format: "%n %u")
                          ul.mt-2.space-y-0.5
                            - order.order_items.each do |item|
                              li.text-xs style="color: var(--text-muted);"
                                | #{item.qty} × #{item.product_variant.product&.name || 'Produit supprimé'} (#{item.product_variant.name})
              - else
                p.px-4.py-6.text-center.text-sm style="color: var(--text-muted);"
                  | Aucune commande sur ce point de retrait pour cette fournée.
      - else
        p.text-center.text-sm style="color: var(--text-muted);" Aucun point de retrait ouvert sur cette fournée.

    .mt-6.hidden data-dashboard-tabs-target="panel" data-panel="products"
      .flex.flex-wrap.items-center.justify-between.gap-3 data-controller="dashboard-filter"
        .flex.flex-wrap.items-center.gap-2(data-filter-group)
          button.adm-filter.adm-filter-active type="button" data-filter="all" data-action="dashboard-filter#change"
            | Tous les produits
          button.adm-filter type="button" data-filter="breads" data-action="dashboard-filter#change"
            | Pains uniquement
          button.adm-filter type="button" data-filter="dough_balls" data-action="dashboard-filter#change"
            | Autres catégories
        p.text-xs style="color: var(--text-muted);"
          | #{pluralize(kpis[:variants_count], "variante")} présentes dans les commandes.
        .w-full.overflow-x-auto.overflow-hidden style="border: 1px solid var(--border-subtle); border-radius: var(--radius-md);" data-dashboard-filter-target="container"
          table.adm-grid
            thead
              tr
                th Article
                th Quantité
                th Notes
            tbody
              - if @dashboard.variant_stats.any?
                - @dashboard.variant_stats.each do |stat|
                  - variant = stat[:variant]
                  - product = stat[:product]
                  - attachment = variant_image_attachment(variant)
                  tr data-dashboard-filter-target="row" data-category="#{product.category}"
                    td
                      .flex.items-center.gap-3
                        .h-10.w-10.overflow-hidden.rounded-md style="background: var(--surface-sunk); border: 1px solid var(--border-subtle);"
                          - if attachment.present?
                            - if attachment.variable?
                              = image_tag attachment.variant(resize_to_limit: [48, 48]), class: "h-full w-full object-cover", alt: variant.name
                            - else
                              = image_tag attachment, class: "h-full w-full object-cover", alt: variant.name
                          - else
                            .flex.h-full.w-full.items-center.justify-center.text-xs.font-semibold style="color: var(--text-muted);"
                              = product.name.first.upcase
                        div
                          p.font-semibold style="color: var(--text-strong);"
                            | #{product.name} (#{variant.name})
                    td.adm-grid-num.font-semibold style="color: var(--text-strong);"
                      = stat[:units_count]
                    td.text-xs style="color: var(--text-muted);"
                      - if product.breads?
                        - if stat[:mold_type]
                          = stat[:mold_type].name
                        - else
                          = adm_chip "À assigner", tone: :warning
                      - else
                        | —
              - else
                = adm_empty_row(colspan: 3, title: "Aucun article commandé pour l'instant.", hint: "Les articles apparaissent dès la première commande sur cette fournée.")

    .mt-4.sm:mt-6 data-dashboard-tabs-target="panel" data-panel="clients"
      - if @dashboard.customer_breakdown.any?
        - variants_by_product = @dashboard.variant_stats.sort_by do |stat| \
            [ \
              stat[:product].breads? ? 0 : 1,
              stat[:product].name.downcase,
              stat[:variant].name.downcase \
            ] \
          end.group_by { |stat| stat[:product] }
        - all_variants = variants_by_product.flat_map { |product, stats| stats.map { |stat| stat[:variant] } }
        - customer_variant_quantities = {}
        - @dashboard.customer_breakdown.each do |entry|
          - customer = entry[:customer]
          - quantities = {}
          - entry[:orders].each do |customer_order|
            - customer_order[:items].each do |item|
              - variant_id = item[:variant].id
              - quantities[variant_id] ||= 0
              - quantities[variant_id] += item[:qty]
          - customer_variant_quantities[customer.id] = quantities
        / #71 : conteneur scrollable sur les 2 axes (max-h + overflow-auto) pour
        / que l'en-tête produits (thead.sticky.top-0) reste figé au défilement vertical.
        .overflow-auto class="max-h-[75vh]" style="border: 1px solid var(--border-subtle); border-radius: var(--radius-md);"
          table.adm-grid.adm-grid-matrix
            thead
              tr
                th.sticky.left-0.z-30 rowspan=2 style="position: sticky; left: 0;"
                - variants_by_product.each do |product, stats|
                  th.align-bottom colspan=stats.size title=product.name style="border-left: 1px solid var(--border-strong);"
                    div
                      p.text-xs.font-semibold.normal-case.leading-snug style="color: var(--text-strong);" = product.short_name
                th.sticky.right-0.z-30.text-right rowspan=2 style="position: sticky; right: 0;" Total
              tr
                - variants_by_product.each do |product, stats|
                  - stats.each do |stat|
                    th.align-bottom title=stat[:variant].name style="width: 100px; border-left: 1px solid var(--border-strong);"
                      div
                        p.text-xs.normal-case.leading-snug style="color: var(--text-body);" = stat[:variant].name
                        p.adm-grid-num.font-medium.normal-case.leading-snug style="color: var(--text-faint); font-size: 11px;" = number_to_currency(stat[:variant].price_euros, unit: "€", separator: ",", delimiter: " ")
              / #71/#compta : la ligne « Total » vit dans le thead sticky pour rester
              / figée au défilement vertical, sous les en-têtes produits/variantes.
              tr.adm-grid-total
                td.sticky.left-0.z-30 style="position: sticky; left: 0;" Total
                - all_variants.each do |variant|
                  - column_total = customer_variant_quantities.values.sum { |q| q[variant.id] || 0 }
                  td.adm-grid-num.text-center style="width: 50px;"
                    = column_total
                td.adm-grid-num.sticky.right-0.z-30.text-right style="position: sticky; right: 0;"
                  = customer_variant_quantities.values.sum { |q| q.values.sum }
            tbody
              - @dashboard.customer_breakdown.each do |entry|
                - customer = entry[:customer]
                - quantities = customer_variant_quantities[customer.id]
                - row_total = quantities.values.sum
                tr
                  td.sticky.left-0.z-10.font-semibold style="position: sticky; left: 0; background: var(--surface-card); color: var(--text-strong);"
                    = customer.full_name
                  - all_variants.each do |variant|
                    - qty = quantities[variant.id] || 0
                    td.adm-grid-num.text-center style="width: 50px; border-left: 1px solid var(--border-strong); color: var(--text-strong);"
                      - if qty > 0
                        span.font-semibold = qty
                      - else
                        span style="color: var(--text-faint);" —
                  td.adm-grid-num.text-right.font-semibold style="color: var(--text-strong);"
                    = row_total
      - else
        p.text-center.text-sm style="color: var(--text-muted);" Aucun client n'a encore passé commande.

    .mt-6.hidden data-dashboard-tabs-target="panel" data-panel="timeline"
      - if @dashboard.orders.any?
        .space-y-4 data-controller="dashboard-filter"
          .flex.flex-wrap.items-center.gap-2(data-filter-group)
            button.adm-filter.adm-filter-active type="button" data-filter="all" data-action="dashboard-filter#change"
              | Toutes
            - ['pending', 'unpaid', 'paid', 'ready', 'picked_up', 'cancelled', 'no_show'].each do |order_status|
              button.adm-filter type="button" data-filter=order_status data-action="dashboard-filter#change"
                = order_status_label(order_status)
          .overflow-hidden style="border: 1px solid var(--border-subtle); border-radius: var(--radius-md);"
            - @dashboard.orders.each do |order|
              .flex.flex-col.gap-4.border-b.px-4.py-4.last:border-b-0.sm:px-6.lg:flex-row.lg:items-center.lg:justify-between style="border-color: var(--border-subtle);" data-dashboard-filter-target="row" data-category="#{order.status}"
                div
                  p.font-semibold style="color: var(--text-strong);" = order.customer.full_name
                  p.text-sm style="color: var(--text-muted);"
                    | #{order.created_at.strftime("%d/%m/%Y à %H:%M")}
                .flex.-space-x-2
                  - order.order_items.each do |order_item|
                    - variant = order_item.product_variant
                    - product = variant.product
                    - attachment = variant_image_attachment(variant)
                    .inline-flex.h-10.w-10.items-center.justify-center.rounded-full.text-xs.font-semibold style="background: var(--surface-sunk); color: var(--text-muted); box-shadow: 0 0 0 2px var(--surface-card);" title="#{variant.name} (×#{order_item.qty})"
                      - if attachment.present?
                        - if attachment.variable?
                          = image_tag attachment.variant(resize_to_limit: [40, 40]), class: "h-full w-full rounded-full object-cover", alt: variant.name
                        - else
                          = image_tag attachment, class: "h-full w-full rounded-full object-cover", alt: variant.name
                      - else
                        span = product.name.first.upcase
                .flex.flex-col.items-start.gap-2.text-sm.lg:flex-row.lg:items-center.lg:gap-6 style="color: var(--text-strong);"
                  = adm_order_status_chip(order.status)
                  p.adm-grid-num.font-semibold
                    = number_to_currency(order.total_euros, unit: "€", separator: ",", delimiter: " ")
                  = link_to "Voir la commande", admin_order_path(order), class: "adm-rowaction text-xs"
      - else
        p.text-center.text-sm style="color: var(--text-muted);" Pas encore de flux pour cette journée.

    .mt-6.hidden data-dashboard-tabs-target="panel" data-panel="flags"
      - if @dashboard.customer_breakdown.any?
        - total_flags = @dashboard.customer_breakdown.sum { |e| e[:orders].flat_map { |o| o[:items] }.sum { |i| i[:qty] } }

        .mb-5.flex.flex-wrap.items-center.gap-4
          .flex.items-center.gap-2
            .flex.h-8.w-8.items-center.justify-center.rounded-full style="background: var(--surface-sunk); color: var(--text-muted);"
              = lucide "users", size: 16
            p.text-sm style="color: var(--text-muted);"
              span.font-bold style="color: var(--text-strong);" = @dashboard.customer_breakdown.size
              |  clients
          .h-4.w-px style="background: var(--border-strong);"
          .flex.items-center.gap-2
            .flex.h-8.w-8.items-center.justify-center.rounded-full style="background: var(--surface-sunk); color: var(--text-muted);"
              = lucide "tag", size: 16
            p.text-sm style="color: var(--text-muted);"
              span.font-bold style="color: var(--text-strong);" = total_flags
              |  drapeaux à préparer

        .grid.gap-4.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3
          - @dashboard.customer_breakdown.each_with_index do |entry, idx|
            - customer = entry[:customer]
            - customer_items = []
            - entry[:orders].each do |customer_order|
              - customer_order[:items].each do |item|
                - variant = item[:variant]
                - product = variant.product
                - customer_items << { product: product, variant: variant, qty: item[:qty], paid_unit_cents: item[:paid_unit_cents], label: "#{product.name} — #{variant.name}" }
            - grouped = customer_items.group_by { |i| i[:label] }.map { |label, items| { label: label, qty: items.sum { |i| i[:qty] }, product: items.first[:product], variant: items.first[:variant], paid_unit_cents: items.first[:paid_unit_cents] } }.sort_by { |i| i[:label].downcase }
            - total_items = grouped.sum { |i| i[:qty] }

            .relative.rounded-lg.p-4.transition-shadow.hover:shadow-md class=adm_flag_class(idx)
              .mb-3.flex.items-start.justify-between.gap-2
                .flex.min-w-0.items-center.gap-2
                  .adm-flag-dot.h-3.w-3.shrink-0.rounded-full
                  h3.adm-flag-ink.truncate.text-sm.font-bold = customer.full_name
                .adm-flag-inner.adm-flag-ink.shrink-0.rounded-full.px-2.5.py-0.5.text-xs.font-bold
                  = "#{total_items} #{total_items > 1 ? 'pains' : 'pain'}"
              .space-y-2
                - grouped.each do |item|
                  .adm-flag-inner.flex.items-center.gap-3.rounded-md.px-3.py-2
                    .adm-flag-ink.flex.h-8.w-8.items-center.justify-center.rounded-md.text-sm.font-bold style="background: var(--surface-inset);"
                      = item[:qty]
                    .min-w-0.flex-1
                      p.truncate.text-sm.font-semibold style="color: var(--text-strong);" = item[:product].name
                      p.truncate.text-xs style="color: var(--text-muted);" = item[:variant].name
                    .shrink-0.text-right
                      p.adm-grid-num.text-sm.font-bold style="color: var(--text-strong);" = number_to_currency(item[:paid_unit_cents] * item[:qty] / 100.0, unit: "€", separator: ",", delimiter: " ")
                      - if item[:qty] > 1
                        p.adm-grid-num style="color: var(--text-faint); font-size: 10px;" = "#{number_to_currency(item[:paid_unit_cents] / 100.0, unit: '€', separator: ',', delimiter: ' ')} / u"
      - else
        p.text-center.text-sm style="color: var(--text-muted);" Aucun client n'a encore passé commande.
