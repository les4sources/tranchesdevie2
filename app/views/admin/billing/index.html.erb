<% content_for :title, "Facturation mensuelle" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Facturation mensuelle" do %>
  <%= link_to "Export CSV",
              admin_billing_path(format: :csv, month: @month.strftime("%Y-%m"), customer_id: @customer&.id),
              class: adm_btn_class(:default) %>
<% end %>

<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">
  Clients professionnels — <%= month_label(@month) %>
</p>

<div class="adm-card mb-4 p-3 sm:p-4">
  <%= form_with url: admin_billing_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :month, "Mois", class: "adm-eyebrow mb-1 block" %>
      <%= f.month_field :month, value: @month.strftime("%Y-%m"), class: adm_field_class("!w-auto") %>
    </div>
    <div>
      <%= f.label :customer_id, "Client", class: "adm-eyebrow mb-1 block" %>
      <%= f.select :customer_id,
            options_from_collection_for_select(@billable_customers, :id, :full_name, @customer&.id),
            { include_blank: "Tous les clients" },
            { class: adm_field_class("!w-auto") } %>
    </div>
    <%= f.submit "Filtrer", class: adm_btn_class(:primary) %>
  <% end %>
</div>

<div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Total à facturer</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.grand_total_cents) %></p>
  </div>
  <div class="adm-card p-4" style="border-color: var(--success-200);">
    <p class="adm-eyebrow" style="color: var(--success-700);">Déjà payé</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--success-700);"><%= reports_currency(@report.paid_total_cents) %></p>
  </div>
  <div class="adm-card p-4" style="border-color: var(--danger-200);">
    <p class="adm-eyebrow" style="color: var(--danger-700);">Impayé</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--danger-700);"><%= reports_currency(@report.unpaid_total_cents) %></p>
  </div>
</div>

<% if @report.customers.any? %>
  <div class="space-y-4">
    <% @report.customers.each do |billing| %>
      <section class="adm-card overflow-hidden">
        <div class="adm-cardhd">
          <div>
            <h2 class="text-sm font-semibold" style="color: var(--text-strong);">
              <%= link_to billing.customer.full_name, admin_customer_path(billing.customer), class: "hover:underline" %>
            </h2>
            <p class="mt-0.5 text-xs" style="color: var(--text-muted);">
              <%= pluralize(billing.orders.size, "commande") %> —
              Total <span class="font-medium" style="color: var(--text-strong);"><%= reports_currency(billing.total_cents) %></span>
              <% if billing.unpaid_total_cents.positive? %>
                · <span style="color: var(--danger-700);">Impayé <%= reports_currency(billing.unpaid_total_cents) %></span>
              <% end %>
            </p>
          </div>

          <%# Relevé mensuel groupé (par jour de cuisson) du client — #38. %>
          <%= link_to "Relevé de commandes (PDF) du mois",
                admin_period_invoice_path(customer_id: billing.customer.id, month: @month.strftime("%Y-%m")),
                class: adm_btn_class(:default) %>
        </div>

        <div class="overflow-x-auto">
          <table class="adm-grid">
            <thead>
              <tr>
                <th>Date de cuisson</th>
                <th>Articles</th>
                <th class="text-right">Montant</th>
                <th>Paiement</th>
              </tr>
            </thead>
            <tbody>
              <% billing.orders.each do |order| %>
                <tr>
                  <td class="whitespace-nowrap">
                    <%= link_to l(order.bake_day.baked_on), admin_order_path(order), class: "adm-link" %>
                    <%= link_to "Relevé de commandes (PDF)",
                          admin_order_invoice_path(order_id: order.id),
                          class: "adm-rowaction mt-0.5 block text-xs" %>
                  </td>
                  <td style="color: var(--text-muted);">
                    <ul class="space-y-0.5">
                      <% order.order_items.each do |item| %>
                        <li><%= item.qty %>x <%= item.full_name %></li>
                      <% end %>
                    </ul>
                  </td>
                  <td class="adm-grid-num whitespace-nowrap text-right" style="color: var(--text-strong);">
                    <%= reports_currency(order.total_cents) %>
                  </td>
                  <td class="whitespace-nowrap">
                    <% if order.payment_received? %>
                      <%= adm_chip "Payé", tone: :success %>
                      <% if order.paid_at %>
                        <span class="mt-0.5 block text-xs" style="color: var(--text-muted);">le <%= l(order.paid_at.to_date) %></span>
                      <% end %>
                    <% else %>
                      <%= adm_chip "Impayé", tone: :danger %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="adm-grid-total">
                <td colspan="2">Total du mois</td>
                <td class="adm-grid-num text-right"><%= reports_currency(billing.total_cents) %></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    <% end %>
  </div>
<% else %>
  <div class="adm-card p-6">
    <p class="text-sm" style="color: var(--text-muted);">
      Aucune commande à facturer pour les clients professionnels sur ce mois.
    </p>
  </div>
<% end %>
