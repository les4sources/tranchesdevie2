<% content_for :title, "Modifier le mangeur" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Modifier le mangeur" %>
<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">Mettez à jour les informations du mangeur.</p>

<%= render "errors", customer: @customer %>

<div class="adm-card p-4 sm:p-6">
  <%= form_with model: @customer, url: admin_customer_path(@customer), local: true do |f| %>
    <%= render "form_fields", f: f, groups: @groups, show_sms_opt_out: true %>

    <div class="mt-8 flex flex-wrap items-center justify-end gap-2">
      <%= link_to "Annuler", admin_customer_path(@customer), class: adm_btn_class(:ghost) %>
      <%= f.submit "Mettre à jour", class: adm_btn_class(:primary) %>
    </div>
  <% end %>
</div>
