<% content_for :title, "Nouveau mangeur" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Nouveau mangeur" %>
<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">Ajoutez un mangeur pour pouvoir créer une commande en son nom.</p>

<%= render "errors", customer: @customer %>

<div class="adm-card p-4 sm:p-6">
  <%= form_with model: @customer, url: admin_customers_path, local: true do |f| %>
    <%= render "form_fields", f: f, groups: @groups, show_sms_opt_out: false %>

    <div class="mt-8 flex flex-wrap items-center justify-end gap-2">
      <%= link_to "Annuler", admin_customers_path, class: adm_btn_class(:ghost) %>
      <%= f.submit "Créer le mangeur", class: adm_btn_class(:primary) %>
    </div>
  <% end %>
</div>
