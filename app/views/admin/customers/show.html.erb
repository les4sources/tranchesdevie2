<% content_for :title, "Mangeur - #{@customer.full_name}" %>
<% content_for :layout, "admin" %>

<div data-controller="sms-modal email-modal">
<%= adm_page_header "Mangeur : #{@customer.full_name}" do %>
  <%= link_to "Modifier", edit_admin_customer_path(@customer), class: adm_btn_class(:default) %>
  <% if @customer.orders.empty? %>
    <%= button_to "Supprimer", admin_customer_path(@customer), method: :delete, form: { data: { turbo_confirm: "Supprimer ce mangeur ? Cette action est définitive." } }, class: adm_btn_class(:danger) %>
  <% end %>
  <%= link_to "Nouvelle commande", new_admin_order_path(customer_id: @customer.id), class: adm_btn_class(:primary) %>
  <% if @customer.sms_enabled? %>
    <button type="button" data-action="click->sms-modal#open" class="<%= adm_btn_class(:default) %>">
      Envoyer un SMS
    </button>
  <% end %>
<% end %>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <div class="adm-card p-4 sm:p-6">
    <h2 class="mb-4 text-xl font-semibold" style="color: var(--text-strong);">Informations</h2>

    <dl class="space-y-3">
      <div>
        <dt class="adm-eyebrow">Prénom</dt>
        <dd class="mt-1 text-sm" style="color: var(--text-strong);"><%= @customer.first_name %></dd>
      </div>

      <% if @customer.last_name.present? %>
        <div>
          <dt class="adm-eyebrow">Nom</dt>
          <dd class="mt-1 text-sm" style="color: var(--text-strong);"><%= @customer.last_name %></dd>
        </div>
      <% end %>

      <% if @customer.phone_e164.present? %>
        <div>
          <dt class="adm-eyebrow">Téléphone</dt>
          <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @customer.phone_e164 %></dd>
        </div>
      <% end %>

      <% if @customer.email.present? %>
        <div>
          <dt class="adm-eyebrow">Email</dt>
          <dd class="mt-1 text-sm" style="color: var(--text-strong);"><%= @customer.email %></dd>
        </div>
      <% end %>

      <div>
        <dt class="adm-eyebrow">SMS activé</dt>
        <dd class="mt-1">
          <%= adm_chip(@customer.sms_enabled? ? "Oui" : "Non", tone: @customer.sms_enabled? ? :success : :danger) %>
        </dd>
      </div>

      <div>
        <dt class="adm-eyebrow">Date d'inscription</dt>
        <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @customer.created_at.strftime("%d/%m/%Y à %H:%M") %></dd>
      </div>

      <% if @customer.billable? %>
        <div>
          <dt class="adm-eyebrow">Facturation</dt>
          <dd class="mt-1"><%= adm_chip "Facturable", tone: :brand %></dd>
        </div>
      <% end %>

      <div>
        <dt class="adm-eyebrow">Groupes</dt>
        <dd class="mt-1 text-sm" style="color: var(--text-strong);">
          <% if @customer.groups.any? %>
            <%= @customer.groups.map { |g| "#{g.name} (#{g.discount_percent}%)" }.join(", ") %>
            <% if @customer.effective_discount_percent > 0 %>
              <span class="mt-1 block text-xs" style="color: var(--text-muted);">Remise appliquée : <%= @customer.effective_discount_percent %>%</span>
            <% end %>
          <% else %>
            <span style="color: var(--text-faint);">Aucun groupe</span>
          <% end %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="adm-card p-4 sm:p-6">
    <h2 class="mb-4 text-xl font-semibold" style="color: var(--text-strong);">Statistiques</h2>

    <dl class="space-y-3">
      <div>
        <dt class="adm-eyebrow">Nombre de commandes</dt>
        <dd class="adm-grid-num mt-1 text-lg font-semibold" style="color: var(--text-strong);"><%= @customer.orders.count %></dd>
      </div>

      <% total_revenue = @customer.orders.where(status: Order::COMPLETED_STATUSES).sum(:total_cents) %>
      <div>
        <dt class="adm-eyebrow">Chiffre d'affaires total</dt>
        <dd class="adm-grid-num mt-1 text-lg font-semibold" style="color: var(--text-strong);">
          <%= number_to_currency(total_revenue / 100.0, unit: "€", separator: ",", delimiter: "") %>
        </dd>
      </div>
    </dl>
  </div>

  <% if @wallet %>
    <%# Portefeuille (#138) — lecture seule : solde, solde disponible, alerte solde bas. %>
    <div class="adm-card p-4 sm:p-6">
      <h2 class="mb-4 text-xl font-semibold" style="color: var(--text-strong);">Portefeuille</h2>

      <dl class="space-y-3">
        <div>
          <dt class="adm-eyebrow">Solde</dt>
          <dd class="adm-grid-num mt-1 text-lg font-semibold" style="color: <%= @wallet.low_balance? ? "var(--danger-700)" : "var(--text-strong)" %>;">
            <%= number_to_currency(@wallet.balance_cents / 100.0, unit: "€", separator: ",", delimiter: "") %>
            <% if @wallet.low_balance? %>
              <span class="ml-2"><%= adm_chip "Solde bas", tone: :danger %></span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="adm-eyebrow">Solde disponible</dt>
          <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);">
            <%= number_to_currency(@wallet.available_balance_cents / 100.0, unit: "€", separator: ",", delimiter: "") %>
          </dd>
        </div>

        <% committed_cents = @wallet.balance_cents - @wallet.available_balance_cents %>
        <% if committed_cents.positive? %>
          <div>
            <dd class="text-xs" style="color: var(--text-muted);">
              <%= number_to_currency(committed_cents / 100.0, unit: "€", separator: ",", delimiter: "") %> engagés dans des commandes planifiées
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  <% end %>
</div>

<div class="adm-card mt-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-xl font-semibold" style="color: var(--text-strong);">Commandes</h2>
    <span class="adm-eyebrow"><%= compte_commandes(@orders.size) %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Commande</th>
          <th>Jour de cuisson</th>
          <th class="text-right">Total</th>
          <th>Statut</th>
          <th>Date</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @orders.empty? %>
          <%= adm_empty_row(colspan: 6, title: "Aucune commande pour ce mangeur.") do %>
            <%= link_to "Nouvelle commande", new_admin_order_path(customer_id: @customer.id), class: adm_btn_class(:primary) %>
          <% end %>
        <% end %>

        <% @orders.each do |order| %>
          <tr>
            <td class="adm-grid-num whitespace-nowrap font-semibold" style="color: var(--text-strong);">
              <span class="inline-flex items-center gap-2">
                <%= order_payment_method_icon(order) %>
                <%= order.order_number %>
              </span>
            </td>
            <td class="adm-grid-num whitespace-nowrap">
              <%= order.bake_day.baked_on.strftime("%d/%m/%Y") %>
            </td>
            <td class="adm-grid-num whitespace-nowrap text-right font-medium" style="color: var(--text-strong);">
              <%= number_to_currency(order.total_euros, unit: "€", separator: ",", delimiter: "") %>
            </td>
            <td><%= adm_order_status_chip(order.status) %></td>
            <td class="adm-grid-num whitespace-nowrap"><%= order.created_at.strftime("%d/%m/%Y") %></td>
            <td class="whitespace-nowrap text-right">
              <%= link_to "Voir", admin_order_path(order), class: "adm-rowaction" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="adm-card mt-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-xl font-semibold" style="color: var(--text-strong);">SMS envoyés</h2>
    <span class="adm-eyebrow"><%= @sms_messages.size %> message<%= "s" if @sms_messages.size > 1 %></span>
  </div>

  <% if @sms_messages.empty? %>
    <p class="p-4 text-sm sm:p-6" style="color: var(--text-muted);">Aucun message SMS pour ce mangeur.</p>
  <% else %>
  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Date d'envoi</th>
          <th>Type</th>
          <th>Contenu</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @sms_messages.each do |sms| %>
          <tr>
            <td class="adm-grid-num whitespace-nowrap">
              <%= (sms.sent_at || sms.created_at).strftime("%d/%m/%Y à %H:%M") %>
            </td>
            <td><%= adm_message_kind_chip(sms.kind) %></td>
            <td><%= truncate(sms.body, length: 60) %></td>
            <td class="whitespace-nowrap text-right">
              <%= link_to "Détails", admin_customer_sms_message_path(@customer, sms), class: "adm-rowaction" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

<div class="adm-card mt-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-xl font-semibold" style="color: var(--text-strong);">E-mails envoyés</h2>
    <span class="adm-eyebrow"><%= @email_messages.size %> e-mail<%= "s" if @email_messages.size > 1 %></span>
  </div>

  <% if @email_messages.empty? %>
    <p class="p-4 text-sm sm:p-6" style="color: var(--text-muted);">Aucun e-mail pour ce mangeur.</p>
  <% else %>
  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Date d'envoi</th>
          <th>Type</th>
          <th>Sujet</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @email_messages.each do |email| %>
          <tr>
            <td class="adm-grid-num whitespace-nowrap">
              <%= (email.sent_at || email.created_at).strftime("%d/%m/%Y à %H:%M") %>
            </td>
            <td><%= adm_message_kind_chip(email.kind) %></td>
            <td><%= truncate(email.subject, length: 60) %></td>
            <td class="whitespace-nowrap text-right">
              <button type="button"
                      data-action="click->email-modal#open"
                      data-show-url="<%= admin_customer_email_message_path(@customer, email, format: :json) %>"
                      data-resend-url="<%= resend_admin_customer_email_message_path(@customer, email) %>"
                      class="adm-rowaction">
                Détails
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

<% if @wallet %>
  <%# Mouvements du portefeuille (#138) — lecture seule, du plus récent au plus ancien. %>
  <div class="adm-card mt-4 overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-xl font-semibold" style="color: var(--text-strong);">Mouvements du portefeuille</h2>
      <span class="adm-eyebrow"><%= @wallet_transactions.size %> mouvement<%= "s" if @wallet_transactions.size > 1 %></span>
    </div>

    <% if @wallet_transactions.empty? %>
      <p class="p-4 text-sm sm:p-6" style="color: var(--text-muted);">Aucun mouvement pour ce portefeuille.</p>
    <% else %>
    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th class="text-right">Montant</th>
            <th>Commande</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% @wallet_transactions.each do |txn| %>
            <tr>
              <td class="adm-grid-num whitespace-nowrap">
                <%= txn.created_at.strftime("%d/%m/%Y à %H:%M") %>
              </td>
              <td><%= adm_wallet_transaction_chip(txn.transaction_type) %></td>
              <td class="adm-grid-num whitespace-nowrap text-right font-medium"
                  style="color: <%= txn.amount_cents.negative? ? "var(--danger-700)" : "var(--success-700)" %>;">
                <%= "+" if txn.amount_cents.positive? %><%= number_to_currency(txn.amount_euros, unit: "€", separator: ",", delimiter: "") %>
              </td>
              <td class="adm-grid-num whitespace-nowrap">
                <% if txn.order %>
                  <%= link_to txn.order.order_number, admin_order_path(txn.order), class: "adm-link" %>
                <% else %>
                  <span style="color: var(--text-faint);">—</span>
                <% end %>
              </td>
              <td>
                <%= txn.description.presence || content_tag(:span, "—", style: "color: var(--text-faint);") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  </div>
<% end %>

<div class="mt-4">
  <%= link_to "← Retour à la liste des mangeurs", admin_customers_path, class: "adm-link" %>
</div>

<%# Modal pour visualiser / renvoyer un e-mail %>
<div id="email-modal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     data-email-modal-target="modal"
     data-action="keydown@window->email-modal#closeWithEscape">
  <div class="fixed inset-0 transition-opacity"
       style="background: color-mix(in srgb, var(--ink-900) 55%, transparent);"
       data-email-modal-target="overlay"
       data-action="click->email-modal#closeBackground">
  </div>

  <div class="flex min-h-full items-center justify-center p-4">
    <div class="adm-card relative transform overflow-hidden px-4 pb-4 pt-5 text-left transition-all sm:my-8 sm:w-full sm:max-w-2xl sm:p-6"
         style="box-shadow: var(--shadow-lg);">
      <div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
        <button type="button" data-action="click->email-modal#close" class="<%= adm_btn_class(:ghost, "!p-1") %>">
          <span class="sr-only">Fermer</span>
          <%= lucide "x", size: 18 %>
        </button>
      </div>

      <h3 class="mb-4 text-base font-semibold" style="color: var(--text-strong);">Détails de l'e-mail</h3>

      <dl class="mb-4 space-y-2 text-sm">
        <div class="flex gap-2">
          <dt class="w-24 flex-shrink-0 font-medium" style="color: var(--text-muted);">Destinataire</dt>
          <dd style="color: var(--text-strong);" data-email-modal-target="recipient"></dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-24 flex-shrink-0 font-medium" style="color: var(--text-muted);">Date</dt>
          <dd style="color: var(--text-strong);" data-email-modal-target="date"></dd>
        </div>
        <div class="flex gap-2">
          <dt class="w-24 flex-shrink-0 font-medium" style="color: var(--text-muted);">Sujet</dt>
          <dd class="font-medium" style="color: var(--text-strong);" data-email-modal-target="subject"></dd>
        </div>
      </dl>

      <div id="email-modal-error" class="mb-4 hidden rounded-md p-4"
           style="background: var(--danger-100);" data-email-modal-target="error">
        <p class="text-sm font-medium" style="color: var(--danger-700);"></p>
      </div>

      <div class="mb-4 overflow-hidden rounded-md border" style="height:420px; border-color: var(--border-subtle);">
        <iframe data-email-modal-target="body" class="w-full h-full" sandbox=""></iframe>
      </div>

      <div class="mt-2 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" data-action="click->email-modal#close" class="<%= adm_btn_class(:default) %>">
          Fermer
        </button>
        <button type="button"
                data-action="click->email-modal#resend"
                data-email-modal-target="resendButton"
                class="<%= adm_btn_class(:primary) %>">
          Renvoyer cet e-mail
        </button>
      </div>
    </div>
  </div>
</div>

<%# Modal pour envoyer un SMS %>
<div id="sms-modal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     data-sms-modal-target="modal"
     data-action="keydown@window->sms-modal#closeWithEscape"
     data-turbo-permanent>
  <div class="fixed inset-0 transition-opacity"
       style="background: color-mix(in srgb, var(--ink-900) 55%, transparent);"
       data-sms-modal-target="overlay"
       data-action="click->sms-modal#closeBackground">
  </div>

  <div class="flex min-h-full items-center justify-center p-4">
    <div class="adm-card relative transform overflow-hidden px-4 pb-4 pt-5 text-left transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6"
         style="box-shadow: var(--shadow-lg);">
      <div class="absolute right-0 top-0 hidden pr-4 pt-4 sm:block">
        <button type="button" data-action="click->sms-modal#close" class="<%= adm_btn_class(:ghost, "!p-1") %>">
          <span class="sr-only">Fermer</span>
          <%= lucide "x", size: 18 %>
        </button>
      </div>

      <div class="w-full">
        <h3 class="mb-4 text-base font-semibold" style="color: var(--text-strong);">
          Envoyer un SMS à <%= @customer.full_name %>
        </h3>

        <p class="mb-4 text-sm" style="color: var(--text-muted);">
          Destinataire : <%= @customer.phone_e164.presence || 'Non renseigné' %>
        </p>

        <div id="sms-error" class="mb-4 hidden rounded-md p-4"
             style="background: var(--danger-100);" data-sms-modal-target="error">
          <p class="text-sm font-medium" style="color: var(--danger-700);"></p>
        </div>

        <%= form_with url: send_sms_admin_customer_path(@customer), method: :post, local: false, class: "space-y-4", data: { controller: "sms-modal", sms_modal_target: "form", action: "submit->sms-modal#submit", turbo: "false" } do |f| %>
          <div>
            <%= f.label :body, "Message", class: "adm-eyebrow mb-1 block" %>
            <%= f.text_area :body, rows: 5, required: true, class: adm_field_class, placeholder: "Entrez votre message..." %>
            <p class="mt-2 text-sm" style="color: var(--text-muted);">
              Le message sera envoyé via Smstools.
            </p>
          </div>

          <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <button type="button" data-action="click->sms-modal#close" class="<%= adm_btn_class(:default) %>">
              Annuler
            </button>
            <button type="submit" class="<%= adm_btn_class(:primary) %>">
              Envoyer
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
</div>
