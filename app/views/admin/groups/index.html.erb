<% content_for :title, "Groupes" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Groupes" do %>
  <%= link_to new_admin_group_path, class: adm_btn_class(:primary) do %>
    <%= lucide "plus", size: 15 %> Nouveau groupe
  <% end %>
<% end %>

<div class="adm-card overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Tous les groupes</h2>
    <span class="adm-eyebrow"><%= @groups.size %> groupe<%= "s" if @groups.size > 1 %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Nom</th>
          <th class="text-right">Remise</th>
          <th class="text-right">Clients</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @groups.any? %>
          <% @groups.each do |group| %>
            <tr>
              <td class="font-medium" style="color: var(--text-strong);">
                <%= group.name %>
              </td>
              <td class="adm-grid-num whitespace-nowrap text-right">
                <%= group.discount_percent %>%
              </td>
              <td class="adm-grid-num whitespace-nowrap text-right">
                <%= group.customers.count %>
              </td>
              <td class="whitespace-nowrap">
                <%= link_to "Modifier", edit_admin_group_path(group), class: "adm-rowaction" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <%= adm_empty_row colspan: 4,
                            title: "Aucun groupe enregistré",
                            hint: "Un groupe rassemble des mangeurs qui partagent la même remise." do %>
            <%= link_to "Nouveau groupe", new_admin_group_path, class: adm_btn_class(:primary) %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
