<% content_for :title, "Nouveau groupe" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Nouveau groupe" %>
<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">Créez un nouveau groupe de clients avec une remise.</p>

<%= render "errors", group: @group %>

<div class="adm-card p-4 sm:p-6">
  <%= form_with model: @group, url: admin_groups_path, local: true do |f| %>
    <%= render "form_fields", f: f %>

    <div class="mt-8 flex flex-wrap items-center justify-end gap-2">
      <%= link_to "Annuler", admin_groups_path, class: adm_btn_class(:ghost) %>
      <%= f.submit "Créer le groupe", class: adm_btn_class(:primary) %>
    </div>
  <% end %>
</div>
