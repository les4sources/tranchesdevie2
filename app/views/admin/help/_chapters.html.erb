<ul class="space-y-0.5">
  <% articles.each do |article| %>
    <% active = current && article.slug == current.slug %>
    <li>
      <%= link_to admin_help_article_path(article),
            class: active ? "adm-navlink adm-navlink-active" : "adm-navlink" do %>
        <% if article.icon.present? %>
          <span class="w-5 flex-none text-center" aria-hidden="true"><%= article.icon %></span>
        <% end %>
        <span class="min-w-0 truncate"><%= article.title %></span>
      <% end %>
    </li>
  <% end %>
</ul>
