<%# Styles de la prose du centre d'aide. Scopé à .aide-prose. CSP désactivée
    dans ce projet (voir config/initializers/content_security_policy.rb), donc
    un <style> inline est sûr et garde la feature auto-contenue.

    Toutes les couleurs viennent des tokens du design system
    (app/assets/tailwind/application.css) : la doc doit vieillir avec l'admin
    qu'elle décrit, pas garder sa propre palette. %>
<style>
  .aide-prose { color: var(--text-body); line-height: 1.7; font-size: 0.95rem; }
  /* Les titres de l'admin sont manuscrits (règle globale) — illisible pour de
     la doc : on repasse la prose d'aide en sans-serif. */
  .aide-prose h1, .aide-prose h2, .aide-prose h3,
  .aide-prose h4, .aide-prose h5, .aide-prose h6 {
    font-family: var(--font-sans);
    color: var(--text-strong); font-weight: 700; line-height: 1.25; scroll-margin-top: 5rem;
  }
  .aide-prose h1 { font-size: 1.75rem; margin: 0 0 1rem; }
  .aide-prose h2 { font-size: 1.35rem; margin: 2rem 0 0.75rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border-subtle); }
  .aide-prose h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .aide-prose p { margin: 0 0 1rem; }
  .aide-prose a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
  .aide-prose a:hover { color: var(--accent-press); }
  .aide-prose ul, .aide-prose ol { margin: 0 0 1rem; padding-left: 1.5rem; }
  .aide-prose ul { list-style: disc; }
  .aide-prose ol { list-style: decimal; }
  .aide-prose li { margin: 0.35rem 0; }
  .aide-prose li > ul, .aide-prose li > ol { margin: 0.35rem 0; }
  .aide-prose strong { color: var(--text-strong); font-weight: 600; }
  .aide-prose code {
    font-family: var(--font-mono); font-size: 0.85em;
    background: var(--surface-sunk); padding: 0.15rem 0.35rem;
    border-radius: var(--radius-xs); color: var(--accent-press);
  }
  .aide-prose pre {
    background: var(--ink-900); color: var(--flour-50); padding: 1rem;
    border-radius: var(--radius-md); overflow-x: auto; margin: 0 0 1rem; font-size: 0.85rem;
  }
  .aide-prose pre code { background: transparent; color: inherit; padding: 0; }
  .aide-prose blockquote {
    border-left: 4px solid var(--brand); background: var(--brand-tint); margin: 0 0 1rem;
    padding: 0.75rem 1rem; color: var(--brand-press);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .aide-prose blockquote p:last-child { margin-bottom: 0; }
  .aide-prose table {
    width: 100%; border-collapse: collapse; margin: 0 0 1rem; font-size: 0.9rem;
    display: block; overflow-x: auto;
  }
  .aide-prose th, .aide-prose td { border: 1px solid var(--border-subtle); padding: 0.5rem 0.75rem; text-align: left; }
  .aide-prose th { background: var(--surface-inset); font-weight: 600; color: var(--text-body); }
  .aide-prose hr { border: 0; border-top: 1px solid var(--border-subtle); margin: 2rem 0; }
  /* Captures d'écran : le cadre est ici plutôt que dans les classes du helper,
     pour que le balisage produit par `render_help_markdown` reste sans couleur. */
  .aide-prose .aide-shot img {
    display: block; width: 100%;
    border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
  .aide-prose .aide-shot figcaption { margin-top: 0.5rem; text-align: center; font-size: 0.875rem; color: var(--text-muted); }
  .aide-prose .aide-shot-missing {
    display: flex; align-items: center; justify-content: center;
    border: 2px dashed var(--border-strong); border-radius: var(--radius-lg);
    background: var(--surface-sunk); padding: 2.5rem 1rem;
    font-size: 0.875rem; color: var(--text-faint);
  }
  /* Cases à cocher GFM (tasklist) : pas de puce. */
  .aide-prose ul.contains-task-list, .aide-prose .task-list-item { list-style: none; }
  .aide-prose .task-list-item { padding-left: 0; }
  /* Ancre auto des titres (commonmarker) discrète. */
  .aide-prose .anchor { display: none; }
</style>
