<%# Annuler une commande ET décider dans le même geste du sort de l'argent
    (#annulation-portefeuille). Sur une commande déjà annulée sans
    remboursement, la même modale sert à rembourser après coup.
    Son propre `data-controller="dialog"` : la page en a déjà un pour la modale
    du remboursement partiel. %>
<% refund_only = order.cancelled? %>
<% amount_cents = order.refundable_remaining_cents %>
<% amount = number_to_currency(amount_cents / 100.0, unit: "€", separator: ",", delimiter: "") %>
<% stripe_available = AdminOrderCancellationService.stripe_refundable?(order) %>
<% wallet = order.customer.wallet %>
<% paid_label = order_payment_method_label(order.payment_method) %>
<% sms_enabled = order.customer.sms_enabled? %>

<div data-controller="dialog" class="space-y-2">
  <% if refund_only %>
    <div class="rounded-md p-3 text-sm" style="background: var(--warning-100); border: 1px solid var(--warning-200); color: var(--warning-700);">
      <p class="font-semibold">Commande annulée, mais pas encore remboursée.</p>
      <p class="mt-1">Le client a payé <%= amount %><% if paid_label %> (<%= paid_label.downcase %>)<% end %> : rends-lui cet argent ici.</p>
    </div>
    <button type="button" data-action="dialog#open" class="<%= adm_btn_class(:primary, "w-full") %>">
      Rembourser <%= amount %>…
    </button>
  <% else %>
    <button type="button" data-action="dialog#open" class="<%= adm_btn_class(:danger, "w-full") %>">
      Annuler la commande…
    </button>
  <% end %>

  <dialog id="cancel-order-dialog" class="adm-dialog"
          aria-labelledby="cancel-order-dialog-title"
          data-dialog-target="dialog"
          data-action="click->dialog#backdropClose">
    <div class="adm-cardhd">
      <div>
        <h2 id="cancel-order-dialog-title" class="text-xl font-semibold" style="color: var(--text-strong);">
          <%= refund_only ? "Rembourser la commande annulée" : "Annuler la commande" %>
        </h2>
        <span class="adm-eyebrow"><%= order.order_number %> · <%= order.customer.full_name %></span>
      </div>
      <button type="button" data-action="dialog#close" class="<%= adm_btn_class(:ghost, "!p-1") %>">
        <span class="sr-only">Fermer</span>
        <%= lucide "x", size: 18 %>
      </button>
    </div>

    <%= form_with url: cancel_admin_order_path(order), method: :post, local: true, class: "space-y-4 p-4" do %>
      <% if amount_cents.positive? %>
        <p class="text-sm" style="color: var(--text-body);">
          Le client a payé <strong style="color: var(--text-strong);"><%= amount %></strong><% if paid_label %> (<%= paid_label.downcase %>)<% end %>.
          Que fait-on de cet argent ?
        </p>

        <div class="space-y-2">
          <label class="flex items-start gap-2 rounded-md p-3 text-sm" style="border: 1px solid var(--border-subtle); color: var(--text-strong);">
            <%= radio_button_tag :refund, "wallet", true, class: "mt-0.5", style: "accent-color: var(--brand);" %>
            <span>
              <span class="font-semibold">Recréditer <%= amount %> sur son portefeuille</span>
              <span class="block text-xs" style="color: var(--text-muted);">
                Immédiat. Nouveau solde : <%= number_to_currency(((wallet&.balance_cents || 0) + amount_cents) / 100.0, unit: "€", separator: ",", delimiter: "") %>.
              </span>
            </span>
          </label>

          <% if stripe_available %>
            <label class="flex items-start gap-2 rounded-md p-3 text-sm" style="border: 1px solid var(--border-subtle); color: var(--text-strong);">
              <%= radio_button_tag :refund, "stripe", false, class: "mt-0.5", style: "accent-color: var(--brand);" %>
              <span>
                <span class="font-semibold">Rembourser <%= amount %> sur sa carte / Bancontact</span>
                <span class="block text-xs" style="color: var(--text-muted);">Via Stripe, quelques jours avant d'arriver sur son compte.</span>
              </span>
            </label>
          <% end %>

          <% unless refund_only %>
            <label class="flex items-start gap-2 rounded-md p-3 text-sm" style="border: 1px solid var(--border-subtle); color: var(--text-strong);">
              <%= radio_button_tag :refund, "none", false, class: "mt-0.5", style: "accent-color: var(--brand);" %>
              <span>
                <span class="font-semibold">Ne pas rembourser maintenant</span>
                <span class="block text-xs" style="color: var(--text-muted);">Argent rendu autrement (liquide…). Tu pourras encore rembourser depuis cette fiche.</span>
              </span>
            </label>
          <% end %>
        </div>

        <% if sms_enabled %>
          <label class="flex items-center gap-2 text-sm" style="color: var(--text-body);">
            <%= hidden_field_tag :notify, "0", id: nil %>
            <%= check_box_tag :notify, "1", true, style: "accent-color: var(--brand);" %>
            Prévenir le client par SMS
          </label>
        <% else %>
          <%= hidden_field_tag :notify, "0" %>
        <% end %>
      <% else %>
        <%= hidden_field_tag :refund, "none" %>
        <p class="text-sm" style="color: var(--text-body);">
          Cette commande n'a pas été payée : il n'y a rien à rembourser.
          <% if order.planned? %>Le montant réservé sur son portefeuille est simplement libéré.<% end %>
        </p>
      <% end %>

      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" data-action="dialog#close" class="<%= adm_btn_class(:default, "w-full sm:w-auto") %>">Retour</button>
        <%= submit_tag refund_only ? "Rembourser" : "Annuler la commande",
              class: adm_btn_class(:danger, "w-full sm:w-auto"),
              data: { turbo_confirm: refund_only ? "Confirmer ce remboursement ?" : "Confirmer l'annulation de la commande #{order.order_number} ?" } %>
      </div>
    <% end %>
  </dialog>
</div>
