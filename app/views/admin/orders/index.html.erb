<% content_for :title, "Commandes" %>
<% content_for :layout, "admin" %>

<%
  # Un client verrouillé via l'autocomplétion l'emporte ; sinon on réaffiche la
  # recherche libre telle qu'elle a été tapée.
  customer_field_value = @selected_customer&.full_name || params[:q]
  filters_active = [ params[:q], params[:customer_id], params[:status], params[:payment_status], params[:bake_day_id] ].any?(&:present?)
%>

<%= adm_page_header "Commandes" do %>
  <%= link_to "Nouveau mangeur", new_admin_customer_path, class: adm_btn_class(:default) %>
  <%= link_to new_admin_order_path, class: adm_btn_class(:primary) do %>
    <%= lucide "plus", size: 15 %> Nouvelle commande
  <% end %>
<% end %>

<%# ------------------------------------------------------------------ %>
<%# Console de recherche : trouver un mangeur d'abord, affiner ensuite. %>
<%# ------------------------------------------------------------------ %>
<%= form_with url: admin_orders_path, method: :get, local: true, class: "adm-card mb-4" do |f| %>
  <div class="p-3 sm:p-4">
    <div data-controller="customer-filter"
         data-customer-filter-url-value="<%= search_admin_customers_path %>"
         class="relative">
      <label for="orders-customer-search" class="adm-eyebrow mb-1.5 flex items-center gap-1.5">
        <%= lucide "user-round", size: 12 %>
        Trouver un mangeur
      </label>

      <%= hidden_field_tag :customer_id, params[:customer_id],
                           data: { customer_filter_target: "customerId" } %>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3" style="color: var(--text-faint);">
          <%= lucide "search", size: 16 %>
        </span>

        <%= text_field_tag :q, customer_field_value,
              id: "orders-customer-search",
              autocomplete: "off",
              placeholder: "Nom, e-mail, GSM ou n° de commande…",
              class: adm_field_class("!py-2 !pl-10 !pr-20"),
              role: "combobox",
              "aria-autocomplete": "list",
              "aria-expanded": "false",
              "aria-controls": "orders-customer-results",
              data: {
                customer_filter_target: "input",
                action: "input->customer-filter#search focus->customer-filter#focus keydown->customer-filter#keydown"
              } %>

        <div class="absolute inset-y-0 right-0 flex items-center gap-1 pr-2">
          <button type="button"
                  title="Effacer la recherche"
                  class="<%= "hidden " if customer_field_value.blank? %>adm-btn adm-btn-ghost !p-1"
                  data-customer-filter-target="clear"
                  data-action="customer-filter#clear">
            <%= lucide "x", size: 14 %>
          </button>
          <kbd class="hidden select-none rounded border px-1.5 py-0.5 font-sans text-[11px] sm:block"
               style="border-color: var(--border-subtle); color: var(--text-faint);">/</kbd>
        </div>

        <%# Propositions vivantes (remplies par le contrôleur Stimulus). %>
        <div id="orders-customer-results"
             role="listbox"
             aria-label="Mangeurs correspondants"
             class="adm-card absolute left-0 right-0 top-full z-40 mt-1.5 hidden max-h-80 overflow-y-auto py-1"
             style="box-shadow: var(--shadow-lg);"
             data-customer-filter-target="results"></div>
      </div>
    </div>

    <%# Filtres secondaires : ils affinent ce que la recherche a déjà cadré. %>
    <div class="mt-3 flex flex-wrap items-center gap-2 border-t pt-3" style="border-color: var(--border-subtle);">
      <span class="adm-eyebrow flex items-center gap-1.5">
        <%= lucide "sliders-horizontal", size: 12 %>
        Affiner
      </span>

      <%= f.select :status, options_for_select([
            [ "Tous les statuts", "" ],
            [ "En attente", "pending" ],
            [ "Payées", "paid" ],
            [ "Prêtes", "ready" ],
            [ "Récupérées", "picked_up" ],
            [ "Non récupérées", "no_show" ],
            [ "Annulées", "cancelled" ]
          ], params[:status]), {}, { class: adm_field_class("!w-auto") } %>

      <%= f.select :payment_status, options_for_select([
            [ "Tous les paiements", "" ],
            [ "Non payées", "unpaid" ],
            [ "Payées", "paid" ],
            [ "Partiellement payées", "partially_paid" ],
            [ "Remboursées", "refunded" ]
          ], params[:payment_status]), {}, { class: adm_field_class("!w-auto") } %>

      <%= f.select :bake_day_id,
            options_for_select(@bake_days.map { |bake_day| [ l(bake_day.baked_on, format: :long_with_day).capitalize, bake_day.id ] }, params[:bake_day_id]),
            { include_blank: "Tous les jours" },
            { class: adm_field_class("!w-auto") } %>

      <div class="ml-auto flex items-center gap-2">
        <% if filters_active %>
          <%= link_to "Tout effacer", admin_orders_path, class: adm_btn_class(:ghost) %>
        <% end %>
        <%= f.submit "Filtrer", class: adm_btn_class(:primary) %>
      </div>
    </div>
  </div>

  <%# Bandeau de contexte : ce qui est filtré, et de quoi le retirer d'un clic. %>
  <% if @selected_customer %>
    <div class="flex flex-wrap items-center gap-3 border-t px-3 py-2.5 sm:px-4"
         style="border-color: var(--border-subtle); background: var(--brand-tint); border-radius: 0 0 var(--radius-md) var(--radius-md);">
      <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full text-[11px] font-semibold uppercase"
            style="background: var(--sage-200); color: var(--sage-700);">
        <%= @selected_customer.full_name.split.first(2).map { |part| part[0] }.join %>
      </span>
      <div class="min-w-0">
        <%= link_to @selected_customer.full_name, admin_customer_path(@selected_customer),
                    class: "block truncate text-sm font-semibold hover:underline", style: "color: var(--sage-700);" %>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs" style="color: var(--text-muted);">
          <% if @selected_customer.email.present? %>
            <span class="inline-flex items-center gap-1"><%= lucide "mail", size: 11 %><%= @selected_customer.email %></span>
          <% end %>
          <% if @selected_customer.phone_e164.present? %>
            <span class="inline-flex items-center gap-1"><%= lucide "phone", size: 11 %><%= national_phone(@selected_customer.phone_e164) %></span>
          <% end %>
        </div>
      </div>
      <span class="ml-auto text-sm font-semibold" style="color: var(--sage-700);">
        <%= compte_commandes(@orders.size) %>
      </span>
    </div>
  <% elsif params[:q].present? %>
    <div class="border-t px-3 py-2.5 text-sm sm:px-4"
         style="border-color: var(--border-subtle); background: var(--surface-inset); color: var(--text-muted); border-radius: 0 0 var(--radius-md) var(--radius-md);">
      <%= compte_commandes(@orders.size) %> pour « <span class="font-semibold" style="color: var(--text-strong);"><%= params[:q] %></span> »
    </div>
  <% end %>
<% end %>

<div class="adm-card overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-xl font-semibold" style="color: var(--text-strong);">
      <%= filters_active ? "Commandes filtrées" : "Toutes les commandes" %>
    </h2>
    <span class="adm-eyebrow"><%= compte_commandes(@orders.size) %></span>
  </div>

  <div class="max-h-[calc(100vh-19rem)] overflow-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Commande</th>
          <th>Client</th>
          <th>Jour de cuisson</th>
          <th class="text-right">Total</th>
          <th>Statut</th>
          <th>Paiement</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @orders.empty? %>
          <%= adm_empty_row(colspan: 7,
                            title: "Aucune commande ne correspond",
                            hint: "Vérifiez l'orthographe du nom, ou élargissez les filtres de statut et de jour de cuisson.") do %>
            <% if filters_active %>
              <%= link_to "Effacer les filtres", admin_orders_path, class: adm_btn_class(:default) %>
            <% end %>
          <% end %>
        <% end %>

        <% @orders.each do |order| %>
          <tr>
            <td class="adm-grid-num font-semibold whitespace-nowrap" style="color: var(--text-strong);">
              <%= link_to order.order_number, admin_order_path(order), class: "hover:underline" %>
            </td>
            <td class="max-w-56">
              <% if order.group_name.present? %>
                <div class="truncate font-medium" style="color: var(--text-strong);"><%= order.group_name %></div>
                <div class="truncate text-xs" style="color: var(--text-muted);"><%= order.customer.full_name %></div>
              <% else %>
                <span class="truncate"><%= order.customer.full_name %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap">
              <%# Une commande party est datée par son événement, sans fournée. %>
              <span class="adm-grid-num"><%= order.event_date.strftime("%d/%m/%Y") %></span>
              <% if order.party_event %>
                <%= adm_chip "Party", tone: :accent %>
              <% end %>
            </td>
            <td class="adm-grid-num whitespace-nowrap text-right font-medium" style="color: var(--text-strong);">
              <%= number_to_currency(order.total_euros, unit: "€", separator: ",", delimiter: "") %>
            </td>
            <td><%= adm_order_status_chip(order.status) %></td>
            <td><%= adm_payment_status_chip(order.payment_status) %></td>
            <td class="whitespace-nowrap text-right">
              <%= link_to "Voir", admin_order_path(order), class: "adm-rowaction" %>
              <%= link_to "Modifier", edit_admin_order_path(order), class: "adm-rowaction ml-3" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
