<% content_for :title, "Nouvelle commande" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Nouvelle commande" %>
<p class="mb-4 text-sm" style="color: var(--text-muted);">Créez une commande manuellement en sélectionnant un client, un jour de cuisson et les quantités souhaitées.</p>

<% if @order.errors.any? %>
  <div class="adm-card mb-4 p-4" style="border-color: var(--danger-200); background: var(--danger-100);">
    <h2 class="text-sm font-semibold" style="color: var(--danger-700);">Veuillez corriger les erreurs suivantes :</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" style="color: var(--danger-700);">
      <% @order.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="adm-card p-4 sm:p-6">
  <%= form_with model: @order, url: admin_orders_path, local: true, data: { controller: "order-calculator", order_calculator_customers_value: @customer_discount_data.to_json } do |f| %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <div data-controller="searchable-select" data-searchable-select-placeholder-value="Choisir un client...">
        <%= f.label :customer_id, "Client", class: "adm-eyebrow mb-1 block" %>
        <% customer_options = @customers.sort_by { |c| [c.last_name.to_s.downcase, c.first_name.to_s.downcase] }.map do |customer|
             label = [customer.last_name&.upcase, customer.first_name].compact.join(' ').squish
             [label, customer.id]
           end %>
        <%= f.select :customer_id,
                     options_for_select(customer_options, @order.customer_id),
                     { include_blank: "Sélectionner un client" },
                     class: adm_field_class,
                     data: { searchable_select_target: "select", order_calculator_target: "customerSelect", action: "change->order-calculator#onCustomerChange" } %>
      </div>

      <%# Régularisation (#198) : les jours passés sont proposés, dans un groupe
          distinct, et le choix d'un jour passé lève un avertissement immédiat. %>
      <div data-controller="past-bake-day" data-past-bake-day-past-ids-value="<%= admin_past_bake_day_ids(@order).to_json %>">
        <%= f.label :bake_day_id, "Jour de cuisson", class: "adm-eyebrow mb-1 block" %>
        <%= f.select :bake_day_id,
                     grouped_options_for_select(admin_bake_day_options(@order), @order.bake_day_id),
                     { include_blank: "Sélectionner un jour" },
                     class: adm_field_class,
                     data: { past_bake_day_target: "select", action: "change->past-bake-day#toggle" } %>
        <div class="hidden mt-2 rounded-md p-3" style="background: var(--warning-100); border: 1px solid var(--warning-200);" data-past-bake-day-target="warning">
          <p class="text-sm font-semibold" style="color: var(--warning-700);">Jour de cuisson passé — régularisation</p>
          <p class="mt-1 text-xs" style="color: var(--text-body);">
            Cette commande sera comptée dans la feuille compta et les revenus boulangers de ce jour-là, pas d'aujourd'hui. Elle est à régler hors ligne.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold" style="color: var(--text-strong);">Produits et variantes</h2>
        <button type="button" class="<%= adm_btn_class(:ghost) %>" data-action="order-calculator#resetQuantities">
          Réinitialiser les quantités
        </button>
      </div>

      <%= render "admin/orders/variant_quantities_grid",
                 products: @products,
                 selected_quantities: @selected_quantities,
                 max_variant_count: @max_variant_count %>

      <div class="mt-4 rounded-md p-4" style="background: var(--surface-inset); border: 1px solid var(--border-subtle);">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold" style="color: var(--text-strong);">Montant indicatif (calcul automatique)</p>
            <p class="text-xs" style="color: var(--text-muted);" data-order-calculator-target="discountInfo">
              Ce montant est calculé à partir des quantités saisies.
            </p>
          </div>
          <p class="adm-grid-num text-lg font-semibold" style="color: var(--brand);" data-order-calculator-target="totalAmount">
            <%= number_to_currency(@calculated_total_cents / 100.0, unit: "€", separator: ",", delimiter: "") %>
          </p>
        </div>
        <div class="mt-2 hidden" data-order-calculator-target="discountMessage">
          <p class="text-xs font-semibold" style="color: var(--success-700);">
            <span data-order-calculator-target="discountText"></span>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      <div>
        <label for="order_final_total_euros" class="adm-eyebrow mb-1 block">Montant final de la commande *</label>
        <% final_total_value = params.dig(:order, :final_total_euros) || (@order.total_cents.present? ? (@order.total_cents / 100.0) : nil) %>
        <%= number_field_tag "order[final_total_euros]",
                             final_total_value,
                             min: 0,
                             step: 0.01,
                             required: true,
                             class: adm_field_class %>
        <% if @order.errors[:total_cents].present? %>
          <p class="mt-1 text-sm" style="color: var(--danger-700);"><%= @order.errors[:total_cents].first %></p>
        <% end %>
      </div>

      <div>
        <fieldset>
          <legend class="adm-eyebrow mb-1 block">Statut de la commande</legend>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <% status_options = {
              unpaid: "Non payée",
              paid: "Payée",
              ready: "Prête",
              picked_up: "Retirée"
            } %>
            <% status_options.each do |value, label| %>
              <label class="flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium"
                     style="border: 1px solid var(--border-subtle); background: var(--surface-card); color: var(--text-body);">
                <%= f.radio_button :status, value, style: "accent-color: var(--brand);" %>
                <span><%= label %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="mt-4">
      <label class="inline-flex items-center gap-2 text-sm" style="color: var(--text-body);">
        <%= f.check_box :requires_invoice, style: "accent-color: var(--brand);" %>
        <span>Il faut une facture pour cette commande</span>
      </label>
    </div>

    <div class="mt-6 flex justify-end gap-2">
      <%= link_to "Annuler", admin_orders_path, class: adm_btn_class(:default) %>
      <%= f.submit "Créer la commande", class: adm_btn_class(:primary) %>
    </div>
  <% end %>
</div>
