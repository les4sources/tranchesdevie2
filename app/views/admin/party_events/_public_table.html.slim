.adm-card.overflow-hidden
  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th Date
          th Titre
          th.text-right Inscrits
          th.text-right Capacité
          th Statut
          th.text-right Actions
      tbody
        - events.each do |event|
          - taken = event.seats_taken
          tr
            td.adm-grid-num.whitespace-nowrap style="color: var(--text-strong);" = l(event.held_on)
            td.font-medium
              = link_to event.title, admin_party_event_path(event), class: "adm-link"
            / Une jauge pleine se signale : c'est le seul chiffre de la ligne
            / qui appelle une décision (refuser, ou pousser la capacité).
            td.adm-grid-num.text-right
              - if event.capacity && taken >= event.capacity
                span.adm-tonetext.adm-tone-danger.font-semibold = taken
              - else
                span style="color: var(--text-strong);" = taken
            td.adm-grid-num.text-right style="color: var(--text-muted);" = event.capacity || "∞"
            td = adm_chip(event.active? ? "Actif" : "Inactif", tone: event.active? ? :success : :neutral)
            td.whitespace-nowrap.text-right
              .flex.flex-wrap.items-center.justify-end.gap-x-3.gap-y-1
                = link_to "Voir le détail", admin_party_event_path(event), class: "adm-rowaction"
                = link_to "Modifier", edit_admin_party_event_path(event), class: "adm-rowaction"
                = link_to "Supprimer", admin_party_event_path(event), data: { turbo_method: :delete, turbo_confirm: "Supprimer cet événement ?" }, class: "adm-rowaction"
