- content_for :title, "Parties"
- content_for :layout, "admin"

= adm_page_header "Événements party" do
  = link_to "Créneaux privés (blocages)", admin_party_slot_blocks_path, class: adm_btn_class(:default)
  / Certaines parties privées arrivent par mail ou par téléphone (#204).
  = link_to "Nouvelle party privée", new_admin_private_party_path, class: adm_btn_class(:default)
  = link_to "Nouvel événement public", new_admin_party_event_path, class: adm_btn_class(:primary)

/ Parties privées (#205) : listées depuis les COMMANDES, comme le rapport.
/ Beaucoup n'ont pas de `PartyEvent` — elles ont été encodées directement en
/ commande — et sans cette section « passées », celles qui en ont un
/ disparaissaient de l'écran le lendemain de leur date.
= render "private_parties", title: "Réservations privées à venir", parties: @upcoming_private_parties, empty: "Aucune réservation privée à venir."

= render "private_parties", title: "Pizza parties privées passées", parties: @past_private_parties, empty: "Aucune pizza party privée passée."

section.mb-8
  h2.mb-4.text-xl.font-semibold style="color: var(--text-strong);" Événements publics à venir
  - if @public_events.any?
    = render "public_table", events: @public_events
  - else
    .adm-card.px-4.py-10.text-center.text-sm style="color: var(--text-muted);"
      | Aucun événement public à venir.

section.mb-8
  h2.mb-4.text-xl.font-semibold style="color: var(--text-strong);" Événements publics passés
  - if @past_public_events.any?
    = render "public_table", events: @past_public_events
  - else
    .adm-card.px-4.py-10.text-center.text-sm style="color: var(--text-muted);"
      | Aucun événement public passé.
