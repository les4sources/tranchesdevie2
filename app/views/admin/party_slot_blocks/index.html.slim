- content_for :title, "Créneaux parties privées"
- content_for :layout, "admin"

= adm_page_header "Créneaux parties privées" do
  = link_to "Parties", admin_party_events_path, class: adm_btn_class(:ghost)

p.mb-5.text-sm style="color: var(--text-muted);"
  | Les parties privées sont ouvertes par défaut (midi &amp; soir), jusqu'à
  strong.mx-1 = @capacity
  | parties par créneau. Bloque ici les créneaux indisponibles.

.grid.grid-cols-1.gap-6.lg:grid-cols-3
  .lg:col-span-1
    .adm-card.p-4.sm:p-6
      h2.mb-3.text-xl.font-semibold style="color: var(--text-strong);" Bloquer un créneau
      = form_with model: [ :admin, @block ], url: admin_party_slot_blocks_path, local: true, class: "space-y-4" do |f|
        - if @block.errors.any?
          .rounded-md.p-3 style="border: 1px solid var(--danger-200); background: var(--danger-100);"
            ul.list-inside.list-disc.text-sm style="color: var(--danger-700);"
              - @block.errors.full_messages.each do |message|
                li= message
        .space-y-2
          = f.label :blocked_on, "Date", class: "adm-eyebrow block"
          = f.date_field :blocked_on, required: true, class: adm_field_class
        .space-y-2
          = f.label :slot, "Créneau", class: "adm-eyebrow block"
          = f.select :slot, [ [ "Toute la journée", "" ], [ "Midi", "midi" ], [ "Soir", "soir" ] ], {}, class: adm_field_class
        .space-y-2
          = f.label :reason, "Motif (optionnel)", class: "adm-eyebrow block"
          = f.text_field :reason, class: adm_field_class
        = f.submit "Bloquer", class: adm_btn_class(:primary)

  .lg:col-span-2
    .adm-card.overflow-hidden
      .overflow-x-auto
        table.adm-grid
          thead
            tr
              th Date
              th Créneau
              th Motif
              th.text-right Action
          tbody
            - if @blocks.any?
              - @blocks.each do |block|
                tr
                  td.adm-grid-num.whitespace-nowrap style="color: var(--text-strong);" = l(block.blocked_on)
                  td style="color: var(--text-muted);" = block.slot ? (block.slot_midi? ? "Midi" : "Soir") : "Toute la journée"
                  td style="color: var(--text-muted);" = block.reason
                  td.whitespace-nowrap.text-right
                    = link_to "Débloquer", admin_party_slot_block_path(block), data: { turbo_method: :delete, turbo_confirm: "Retirer ce blocage ?" }, class: "adm-rowaction"
            - else
              = adm_empty_row colspan: 4, title: "Aucun blocage", hint: "Tous les créneaux à venir sont ouverts."
