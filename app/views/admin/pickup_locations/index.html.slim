- content_for :title, "Points de retrait"
- content_for :layout, "admin"

= adm_page_header "Points de retrait" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_pickup_location_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouveau point de retrait

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Tous les points de retrait
    span.adm-eyebrow = "#{@pickup_locations.size} lieu#{'x' if @pickup_locations.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th.text-right Ordre
          th Nom
          th Description
          th État
          th Par défaut
          th.text-right Fournées à venir
          th Actions
      tbody
        - if @pickup_locations.any?
          - @pickup_locations.each do |pickup_location|
            / Un lieu inactif reste listé — il n'est simplement plus proposé au
            / client : on l'estompe plutôt que de le cacher.
            tr class=("opacity-60" unless pickup_location.active?)
              td.adm-grid-num.text-right = pickup_location.position
              td.font-medium style="color: var(--text-strong);" = pickup_location.name
              td = pickup_location.description.presence || "—"
              td
                - if pickup_location.active?
                  = adm_chip "Actif", tone: :success
                - else
                  = adm_chip "Inactif", tone: :warning
              td
                - if pickup_location.default?
                  = adm_chip "Par défaut", tone: :brand
                - else
                  span style="color: var(--text-faint);" —
              td.adm-grid-num.text-right
                = pickup_location.bake_days.merge(BakeDay.future).count
              td.whitespace-nowrap
                = link_to "Modifier", edit_admin_pickup_location_path(pickup_location), class: "adm-rowaction mr-3"
                - unless pickup_location.default?
                  = button_to "Supprimer", admin_pickup_location_path(pickup_location), method: :delete, data: { turbo_confirm: "Supprimer ce point de retrait ? Les commandes passées continueront de l'afficher." }, class: "adm-rowaction", form: { class: "inline" }
        - else
          = adm_empty_row colspan: 7, title: "Aucun point de retrait défini", hint: "Un point de retrait est le lieu où le mangeur vient chercher sa commande." do
            = link_to "Nouveau point de retrait", new_admin_pickup_location_path, class: adm_btn_class(:primary)
