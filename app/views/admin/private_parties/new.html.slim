- content_for :title, "Nouvelle pizza party privée"
- content_for :layout, "admin"

= adm_page_header "Nouvelle pizza party privée" do
  = link_to "Retour aux parties", admin_party_events_path, class: adm_btn_class(:default)

p.mb-4.text-sm style="color: var(--text-muted);"
  | Pour les parties convenues par mail ou par téléphone, qui ne passent pas par le site.

= render "form", form: @form, customers: @customers, url: admin_private_parties_path, method: :post, submit_label: "Créer la party", errors: @errors
