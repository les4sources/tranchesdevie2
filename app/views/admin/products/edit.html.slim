- content_for :title, "Modifier le produit"
- content_for :layout, "admin"

= adm_page_header "Modifier le produit" do
  = link_to "Retour au produit", admin_product_path(@product), class: adm_btn_class(:ghost)

= form_with model: [:admin, @product], local: true, class: "adm-card p-4 sm:p-6" do |f|
  = render "form_fields", f: f, product: @product, new_record: false

  .mt-6.flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_product_path(@product), class: adm_btn_class(:ghost)
    = f.submit "Enregistrer", class: adm_btn_class(:primary)
