- content_for :title, "Modifier la variante"
- content_for :layout, "admin"

= adm_page_header "Modifier la variante : #{@variant.name}" do
  = link_to "Retour au produit", admin_product_path(@product), class: adm_btn_class(:ghost)

= form_with model: [:admin, @product, @variant], url: variant_admin_product_path(@product, @variant), method: :patch, local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if @variant.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - @variant.errors.full_messages.each do |message|
          li = message

  .grid.grid-cols-1.gap-6.md:grid-cols-2
    div
      = f.label :name, "Nom", class: "adm-eyebrow mb-1 block"
      = f.text_field :name, class: adm_field_class
    div
      = f.label :price_euros, "Prix (€)", class: "adm-eyebrow mb-1 block"
      = f.number_field :price_euros, step: 0.01, min: 0, class: adm_field_class
    div
      = f.label :flour_quantity, "Quantité de pâte requise", class: "adm-eyebrow mb-1 block"
      = f.number_field :flour_quantity, min: 0, step: 1, class: adm_field_class
    div
      = f.label :mold_type_id, "Type de moule", class: "adm-eyebrow mb-1 block"
      = f.collection_select :mold_type_id, MoldType.not_deleted.ordered, :id, :name, { include_blank: "Aucun" }, class: adm_field_class
    - if @product.pizza_party_role_public_party?
      div
        = f.label :party_four_sources_base_euros, "Base 4 Sources (€)", class: "adm-eyebrow mb-1 block"
        = f.number_field :party_four_sources_base_euros, step: 0.01, min: 0, class: adm_field_class
        p.mt-1.text-xs style="color: var(--text-muted);" Part fixe 4 Sources / personne (ex. 3 € adulte, 2 € enfant). Base boulangers = prix − cette base.
    .flex.items-start.md:col-span-2
      .flex.h-5.items-center
        = f.check_box :track_capacity_separately, style: "accent-color: var(--brand);"
      .ml-3.text-sm
        = f.label :track_capacity_separately, "Compter séparément dans le planning (bloc « Moules »)", class: "font-medium", style: "color: var(--text-body);"
        p style="color: var(--text-muted);" La variante reste comptée dans la capacité de son moule, mais son nombre apparaît en plus sur une ligne dédiée (« dont … »).

  .adm-panel.space-y-3
    span.adm-eyebrow.block Prix coûtant (historisé par date d'activation)
    p.text-sm style="color: var(--text-muted);"
      | Saisissez le prix coûtant de la variante et la date à partir de laquelle il s'applique. L'historique est conservé : le coûtant retenu à une date donnée est le dernier saisi dont la date d'activation est antérieure ou égale.
    .space-y-3
      = f.fields_for :variant_cost_prices do |cp_form|
        - cost_price = cp_form.object
        .flex.flex-col.gap-3.pb-3.sm:flex-row.sm:items-end.sm:gap-4 style="border-bottom: 1px solid var(--border-subtle);"
          - if cost_price.persisted?
            = cp_form.hidden_field :id
          .flex-1
            = cp_form.label :amount_euros, "Montant (€)", class: "adm-eyebrow mb-1 block"
            = cp_form.number_field :amount_euros, step: 0.01, min: 0, class: adm_field_class
          .flex-1
            = cp_form.label :active_from, "Date d'activation", class: "adm-eyebrow mb-1 block"
            = cp_form.date_field :active_from, class: adm_field_class
          - if cost_price.persisted?
            label.flex.cursor-pointer.items-center.gap-2
              = cp_form.check_box :_destroy, style: "accent-color: var(--danger-600);"
              span.text-sm style="color: var(--text-muted);" Supprimer

  .adm-panel.space-y-3
    span.adm-eyebrow.block En vente en ligne
    p.text-sm style="color: var(--text-muted);" Pour qu'une variante soit visible et achetable sur le site, elle doit être « Active » et en canal « Vente en ligne ».
    label.flex.cursor-pointer.items-center.gap-2
      = f.check_box :active, style: "accent-color: var(--brand);"
      span.text-sm.font-medium style="color: var(--text-body);" Actif
    .space-y-2
      span.adm-eyebrow.block Canal de vente
      .flex.flex-wrap.items-center.gap-4
        label.flex.cursor-pointer.items-center.gap-2
          = f.radio_button :channel, "store", style: "accent-color: var(--brand);"
          span.text-sm style="color: var(--text-body);" Vente en ligne
        label.flex.cursor-pointer.items-center.gap-2
          = f.radio_button :channel, "admin", style: "accent-color: var(--brand);"
          span.text-sm style="color: var(--text-body);" Boulangers uniquement

  = render "admin/products/group_restrictions", variant: @variant

  = render "admin/products/weekday_restriction_fields", variant: @variant

  .space-y-3 data-controller="variant-ingredients"
    .flex.flex-col.gap-3.sm:flex-row.sm:items-center.sm:justify-between
      span.adm-eyebrow.block Ingrédients
      button.w-fit type="button" class=(adm_btn_class(:default)) data-action="variant-ingredients#add" Ajouter un ingrédient

    #variant-ingredients.space-y-3 data-variant-ingredients-target="container"
      = f.fields_for :variant_ingredients do |vi_form|
        - variant_ingredient = vi_form.object
        .variant-ingredient-item.adm-panel.flex.flex-col.gap-4.sm:flex-row.sm:items-center.sm:gap-4 data-variant-ingredients-target="item"
          = vi_form.hidden_field :id if variant_ingredient.persisted?
          .flex-1.min-w-0
            = vi_form.collection_select :ingredient_id, Ingredient.not_deleted.ordered, :id, :name, { include_blank: "Sélectionner un ingrédient" }, class: "ingredient-select #{adm_field_class}", data: { action: "change->variant-ingredients#updateUnit" }
          .flex.flex-col.gap-2.sm:flex-row.sm:items-center.sm:gap-2.sm:min-w-0
            .flex.items-center.gap-2.flex-1.sm:flex-initial class="sm:min-w-[7rem]"
              = vi_form.number_field :quantity, step: 0.01, min: 0, class: adm_field_class("w-full min-w-[5rem] sm:w-24"), placeholder: "Quantité"
              span.unit-label.whitespace-nowrap.text-sm style="color: var(--text-muted);" = variant_ingredient.ingredient&.unit_label || "g"
            .flex-shrink-0
              = vi_form.hidden_field :_destroy, value: false, class: "destroy-field"
              button.w-full.sm:w-auto type="button" class=(adm_btn_class(:danger)) data-action="variant-ingredients#remove" Supprimer

      - if @variant.variant_ingredients.empty?
        .py-4.text-center.text-sm style="color: var(--text-muted);" data-variant-ingredients-target="empty" Aucun ingrédient assigné

    script type="application/json" data-variant-ingredients-target="ingredientsData"
      = raw Ingredient.not_deleted.ordered.map { |i| { id: i.id, name: i.name, unit_label: i.unit_label } }.to_json

  .space-y-3
    .flex.items-center.justify-between
      span.adm-eyebrow.block Images de la variante
      button#add-image-btn type="button" class=(adm_btn_class(:default)) Ajouter une image
    - image_index = @variant.product_images.size
    script type="application/json" id="variant-images-config"
      | []
    .mb-2.flex.items-center.space-x-2.text-sm style="color: var(--text-muted);"
      = lucide "arrow-up-down", size: 15
      span Glissez-déposez les images pour réorganiser leur ordre d'affichage
    #variant-images.space-y-4 data-image-index=image_index data-variant-id=@variant.id data-reorder-url=reorder_variant_images_admin_product_path(@product, @variant)
      = f.fields_for :product_images do |image_form|
        - product_image = image_form.object
        - if product_image.persisted? || product_image.image.attached?
          - if product_image.persisted?
            = image_form.hidden_field :id
          - draggable_classes = product_image.persisted? ? "draggable-item cursor-move transition-colors" : ""
          - image_data_attr = product_image.persisted? ? { "data-image-id": product_image.id } : {}
          .product-image-item.adm-panel class=draggable_classes *image_data_attr
            .flex.items-start.space-x-4
              .flex-shrink-0.flex.items-center.justify-center.w-8.h-8 style="color: var(--text-faint);"
                = lucide "grip-horizontal", size: 18
              .flex-1.space-y-3
                - if product_image.persisted? && product_image.image.attached?
                  .mb-2.flex.items-center.space-x-2
                    - if product_image.image.variable?
                      = image_tag product_image.image.variant(resize_to_limit: [150, 150]), class: "rounded-md", style: "border: 1px solid var(--border-subtle);"
                    - else
                      = link_to product_image.image.filename.to_s, rails_blob_path(product_image.image, disposition: "attachment"), class: "adm-link"
                    span.text-sm style="color: var(--text-muted);" Image existante
                = image_form.file_field :image, accept: "image/*", direct_upload: true, class: "adm-file"
                = image_form.hidden_field :_destroy, value: false, class: "destroy-field"
              .flex-shrink-0
                button.remove-image-btn type="button" class=(adm_btn_class(:danger)) Supprimer
      - if @variant.product_images.empty?
        .js-images-empty.py-4.text-center.text-sm style="color: var(--text-muted);" Aucune image pour cette variante

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_product_path(@product), class: adm_btn_class(:ghost)
    = f.submit "Enregistrer", class: adm_btn_class(:primary)

script type="module"
  | import { initProductImages } from "product_images"
  | // Initialize after a short delay to ensure DOM is ready
  | setTimeout(() => {
  |   initProductImages();
  | }, 100);
