<% content_for :title, "Produits" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Produits" do %>
  <%= link_to new_admin_product_path, class: adm_btn_class(:primary) do %>
    <%= lucide "plus", size: 15 %> Nouveau produit
  <% end %>
<% end %>

<div class="adm-card overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Catalogue</h2>
    <span class="adm-eyebrow"><%= @products.size %> produit<%= "s" if @products.size > 1 %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Variantes</th>
          <th class="hidden md:table-cell">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @products.any? %>
          <% @products.each do |product| %>
            <tr class="<%= "opacity-60" unless product.active? %>">
              <td class="font-medium">
                <div class="inline-flex items-center gap-2">
                  <span title="<%= product.active? ? "Actif" : "Inactif" %>">
                    <%= adm_dot tone: product.active? ? :success : :danger %>
                  </span>
                  <div class="min-w-0">
                    <%= link_to product.name, admin_product_path(product), class: "adm-link" %>
                    <p class="mt-0.5 truncate text-xs font-normal" style="color: var(--text-muted);"><%= product_category_heading(product.category) %></p>
                  </div>
                </div>
              </td>
              <td>
                <div class="flex flex-wrap gap-1.5">
                  <% product.product_variants.sort_by { |v| -(v.price_cents || 0) }.each do |variant| %>
                    <%# La tonalité dit le canal de vente : boutique, boulangers, ou hors ligne. %>
                    <% variant_tone = if variant.active? && variant.channel == "store"
                         :success
                       elsif variant.active? && variant.channel == "admin"
                         :accent
                       else
                         :neutral
                       end %>
                    <% badge = capture do %>
                      <span class="adm-chip adm-chip-<%= variant_tone %> flex-col items-start px-2 py-1">
                        <span class="leading-tight"><%= variant.name %></span>
                        <% if variant.active? && variant.price_euros.present? %>
                          <span class="adm-grid-num mt-0.5 text-[0.65rem] font-normal leading-none opacity-80"><%= number_to_currency(variant.price_euros, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
                        <% end %>
                      </span>
                    <% end %>

                    <% if product.active? %>
                      <div class="relative inline-block" data-controller="variant-tooltip">
                        <%= badge %>
                        <div data-variant-tooltip-target="popover" class="adm-popover invisible pointer-events-none absolute left-0 top-full z-50 mt-1 min-w-[12rem] px-3 py-2 opacity-0 transition-opacity duration-100" role="tooltip">
                          <p class="adm-eyebrow mb-1.5">Ingrédients</p>
                          <% if variant.variant_ingredients.any? %>
                            <ul class="mb-2 space-y-0.5 text-xs" style="color: var(--text-body);">
                              <% variant.variant_ingredients.each do |vi| %>
                                <li><%= vi.ingredient.name %> : <%= vi.quantity.to_f == vi.quantity.to_f.floor ? vi.quantity.to_i : vi.quantity %> <%= vi.unit_label %></li>
                              <% end %>
                            </ul>
                          <% else %>
                            <p class="mb-2 text-xs" style="color: var(--text-muted);">Aucun ingrédient</p>
                          <% end %>
                          <% if variant.mold_type.present? %>
                            <p class="adm-eyebrow mb-1">Type de moule</p>
                            <p class="mb-2 text-xs" style="color: var(--text-body);"><%= variant.mold_type.name %></p>
                          <% end %>
                          <% if variant.flour_quantity.present? %>
                            <p class="adm-eyebrow mb-1">Quantité de pâte requise</p>
                            <p class="adm-grid-num mb-2 text-xs" style="color: var(--text-body);"><%= variant.flour_quantity %> g</p>
                          <% end %>
                          <% if variant.restricted_groups.any? %>
                            <p class="adm-eyebrow mb-1">N'est en vente que pour les groupes suivants</p>
                            <ul class="mb-2 space-y-0.5 text-xs" style="color: var(--text-body);">
                              <% variant.restricted_groups.each do |group| %>
                                <li><%= group.name %></li>
                              <% end %>
                            </ul>
                          <% end %>
                          <%= link_to "Modifier la variante", edit_variant_admin_product_path(product, variant), class: "adm-link text-xs" %>
                        </div>
                      </div>
                    <% else %>
                      <%= badge %>
                    <% end %>
                  <% end %>
                  <% if product.product_variants.empty? %>
                    <span class="text-xs" style="color: var(--text-faint);">Aucune variante</span>
                  <% end %>
                </div>
              </td>
              <td class="hidden whitespace-nowrap md:table-cell">
                <%= link_to "Voir", admin_product_path(product), class: "adm-rowaction mr-3" %>
                <%= link_to "Modifier", edit_admin_product_path(product), class: "adm-rowaction" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <%= adm_empty_row colspan: 3, title: "Aucun produit", hint: "Créez un premier produit pour démarrer le catalogue." do %>
            <%= link_to "Nouveau produit", new_admin_product_path, class: adm_btn_class(:primary) %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
