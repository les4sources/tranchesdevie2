- content_for :title, "Nouveau produit"
- content_for :layout, "admin"

= adm_page_header "Nouveau produit" do
  = link_to "Retour aux produits", admin_products_path, class: adm_btn_class(:ghost)

= form_with model: [:admin, @product], local: true, class: "adm-card p-4 sm:p-6" do |f|
  = render "form_fields", f: f, product: @product, new_record: true

  .mt-6.flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_products_path, class: adm_btn_class(:ghost)
    = f.submit "Créer", class: adm_btn_class(:primary)
