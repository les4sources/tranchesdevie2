- content_for :title, "Produit: #{@product.name}"
- content_for :layout, "admin"

= adm_page_header @product.name do
  = link_to "Modifier", edit_admin_product_path(@product), class: adm_btn_class(:primary)
  = form_with url: admin_product_path(@product), method: :delete, local: true, data: { controller: "confirmation", action: "submit->confirmation#confirm", confirmation_message_value: "Etes-vous certain·e de vouloir supprimer ce produit ?" } do |f|
    = f.submit "Supprimer", class: adm_btn_class(:danger)
  = link_to "Retour à la liste", admin_products_path, class: adm_btn_class(:ghost)

.adm-card.mb-4
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Informations

  .space-y-6.p-4
    dl.grid.grid-cols-1.gap-6.md:grid-cols-2
      div
        dt.adm-eyebrow Nom
        dd.mt-1.text-sm style="color: var(--text-strong);" = @product.name
      div
        dt.adm-eyebrow Catégorie
        dd.mt-1.text-sm style="color: var(--text-strong);" = product_category_heading(@product.category)
      div
        dt.adm-eyebrow Catégorie interne
        dd.mt-1.text-sm style="color: var(--text-strong);" = product_internal_category_heading(@product.internal_category)
      div
        dt.adm-eyebrow Position
        dd.adm-grid-num.mt-1.text-sm style="color: var(--text-strong);" = @product.position
      div
        dt.adm-eyebrow Farines
        dd.mt-1.text-sm style="color: var(--text-strong);" = @product.flour_composition_label
      div
        dt.adm-eyebrow Statut
        dd.mt-1 = adm_chip(@product.active? ? "Actif" : "Inactif", tone: @product.active? ? :success : :danger)
      div
        dt.adm-eyebrow Canal de vente
        dd.mt-1.text-sm style="color: var(--text-strong);" = ProductDecorator.decorate(@product).channel_label

    - if @product.description.present?
      div
        span.adm-eyebrow Description
        .mt-1.text-sm style="color: var(--text-strong);" = simple_format(@product.description)

    - if @product_images.any?
      div
        span.adm-eyebrow Images
        .mt-2.grid.grid-cols-2.gap-4.md:grid-cols-4
          - @product_images.each do |product_image|
            - if product_image.image.attached?
              .relative.group
                - if product_image.image.variable?
                  = image_tag product_image.image.variant(resize_to_limit: [200, 200]), class: "w-full rounded-md", style: "border: 1px solid var(--border-subtle);"
                - else
                  = link_to product_image.image.filename.to_s, rails_blob_path(product_image.image, disposition: "attachment"), class: "adm-link"
                - if product_image.product_variant.present?
                  .absolute.bottom-0.left-0.right-0.rounded-b-md.px-2.py-1.text-xs style="background: color-mix(in srgb, var(--ink-900) 78%, transparent); color: var(--flour-100);"
                    = product_image.product_variant.name

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Variantes
    = link_to "Ajouter une variante", new_admin_product_variants_path(@product), class: adm_btn_class(:default)

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th Nom
          th Prix
          th Canal de vente
          th Actions
      tbody
        - if @variants.any?
          - @variants.each do |variant|
            tr
              td.font-medium
                span.inline-flex.items-center.gap-2
                  span title=(variant.active? ? "Actif" : "Inactif")
                    = adm_dot tone: (variant.active? ? :success : :danger)
                  = variant.name
              td.adm-grid-num = number_to_currency(variant.price_euros, unit: "€", separator: ",", delimiter: " ")
              td = ProductVariantDecorator.decorate(variant).channel_label
              td.whitespace-nowrap
                = link_to "Modifier", edit_variant_admin_product_path(@product, variant), class: "adm-rowaction mr-3"
                = button_to "Supprimer", variant_admin_product_path(@product, variant), method: :delete, data: { turbo_confirm: "Supprimer ce format ? Cette action est définitive." }, class: "adm-rowaction inline", form: { class: "inline" }
        - else
          = adm_empty_row colspan: 4, title: "Aucune variante pour ce produit", hint: "Une variante porte le format, le prix et la quantité de pâte." do
            = link_to "Ajouter une variante", new_admin_product_variants_path(@product), class: adm_btn_class(:primary)
