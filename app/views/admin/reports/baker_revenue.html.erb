<% content_for :title, "Revenus des boulangers" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Revenus des boulangers" do %>
  <%= link_to "← Reporting",
              admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
<% end %>

<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">
  Période du <%= l(@start_date) %> au <%= l(@end_date) %>
</p>

<div class="adm-card mb-4 p-3 sm:p-4">
  <%= form_with url: baker_revenue_admin_reports_path, method: :get, local: true,
                class: "flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :start_date, "Date de début", class: "adm-eyebrow mb-1 block" %>
      <%= f.date_field :start_date, value: @start_date, class: adm_field_class("!w-auto") %>
    </div>
    <div>
      <%= f.label :end_date, "Date de fin", class: "adm-eyebrow mb-1 block" %>
      <%= f.date_field :end_date, value: @end_date, class: adm_field_class("!w-auto") %>
    </div>
    <%= f.submit "Actualiser", class: adm_btn_class(:primary) %>
  <% end %>
</div>

<% if @report.warnings.any? %>
  <div class="adm-card mb-4 p-4" style="border-color: var(--warning-200); background: var(--warning-100);">
    <h2 class="text-sm font-semibold" style="color: var(--warning-700);">Avertissements</h2>
    <ul class="mt-2 list-inside list-disc space-y-1 text-sm" style="color: var(--warning-700);">
      <% @report.warnings.each do |warning| %>
        <li><%= warning %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# Synthèse de période %>
<div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Chiffre d'affaires</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.total_revenue_cents) %></p>
  </div>
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Commissions Stripe</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);">- <%= reports_currency(@report.total_commission_cents) %></p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">Commandes en ligne uniquement</p>
  </div>
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Lieux de vente</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);">- <%= reports_currency(@report.total_sales_locations_cents) %></p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">Coût des emplacements liés aux fournées</p>
  </div>
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Marge brute</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.gross_margin_cents) %></p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">CA − coûtant − sacs − transport − commissions − lieux de vente</p>
  </div>
  <div class="adm-card p-4" style="border-color: var(--success-200);">
    <p class="adm-eyebrow" style="color: var(--success-700);">Part Les 4 Sources</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--success-700);"><%= reports_currency(@report.four_sources_cents) %></p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">30 % de la marge brute</p>
  </div>
  <div class="adm-card p-4" style="border-color: var(--water-200);">
    <p class="adm-eyebrow" style="color: var(--water-700);">Pool boulangers</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--water-700);"><%= reports_currency(@report.baker_pool_cents) %></p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">70 % de la marge brute</p>
  </div>
</div>

<%# Pizza parties : leur part boulangers est déjà dans le pool ci-dessus, mais
    elle n'apparaissait nulle part — on ne savait pas d'où venait l'argent. Les
    trois lignes ont chacune leur barème, aucune ne passe par le 70/30 du pain. %>
<% party_rows = [
     [ "Parties privées", @report.total_party_persons, @report.total_party_revenue_cents,
       @report.total_party_four_sources_cents, @report.total_party_bakers_cents,
       "Barème privé, au nombre de pâtons." ],
     [ "Parties publiques (site)", @report.total_public_party_persons, @report.total_public_party_revenue_cents,
       @report.total_public_party_four_sources_cents, @report.total_public_party_bakers_cents,
       "Barème public, places adulte/enfant vendues sur le site." ],
     [ "Parties publiques (BilletWeb)", @report.total_historical_party_persons, @report.total_historical_party_revenue_cents,
       @report.total_historical_party_four_sources_cents, @report.total_historical_party_bakers_cents,
       "Recette encaissée par la fondation ; barème public appliqué rétroactivement." ]
   ].reject { |row| row[1].zero? && row[4].zero? } %>
<% if party_rows.any? %>
  <section class="adm-card mb-4 overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Pizza parties</h2>
    </div>

    <p class="px-4 pt-4 text-sm" style="color: var(--text-muted);">
      Une pizza party n'a ni sacs, ni transport, ni tournée : le partage 70/30 des pains ne
      s'y applique pas, chaque type a son propre barème. La part boulangers rejoint ensuite
      le même pool que la production, donc les mêmes artisans et les mêmes partenariats.
      Les parties BilletWeb, elles, sont de l'argent que la fondation doit aux boulangers :
      leur recette n'a jamais transité par l'app et n'entre donc pas dans le chiffre d'affaires.
    </p>

    <div class="mt-4 overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Type</th>
            <th class="text-right">Personnes</th>
            <th class="text-right">Recette</th>
            <th class="text-right">Les 4 Sources</th>
            <th class="text-right">Boulangers</th>
          </tr>
        </thead>
        <tbody>
          <% party_rows.each do |label, persons, revenue_cents, four_sources_cents, bakers_cents, hint| %>
            <tr>
              <td>
                <div class="font-medium" style="color: var(--text-strong);"><%= label %></div>
                <div class="text-xs" style="color: var(--text-muted);"><%= hint %></div>
              </td>
              <td class="adm-grid-num text-right"><%= persons %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(revenue_cents) %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(four_sources_cents) %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(bakers_cents) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="adm-grid-total">
            <td>Total pizza parties</td>
            <td class="adm-grid-num text-right"><%= party_rows.sum { |row| row[1] } %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(party_rows.sum { |row| row[2] }) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(party_rows.sum { |row| row[3] }) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(party_rows.sum { |row| row[4] }) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
<% end %>

<%# Ateliers (#208) : revenu COMPLÉMENTAIRE, identifiable séparément de la
    production. Leur part boulangers est incluse dans le pool ci-dessus, mais
    on la montre à part pour qu'on sache toujours d'où vient l'argent. %>
<% if @report.workshops.any? %>
  <section class="adm-card mb-4 overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Ateliers (revenu complémentaire)</h2>
    </div>

    <div class="p-4">
      <p class="text-sm" style="color: var(--text-muted);">
        Un atelier n'a ni coûtant matière, ni sacs, ni transport : le partage 70/30 des pains
        ne s'y applique pas. Sa recette est partagée selon le taux « ateliers » configuré,
        puis la part boulangers suit les mêmes règles d'artisans et de partenariats que la production.
      </p>

      <% if @report.workshops_undistributed_count.positive? %>
        <div class="adm-card mt-4 p-4 text-sm"
             style="border-color: var(--warning-200); background: var(--warning-100); color: var(--warning-700);">
          <strong><%= @report.workshops_undistributed_count %></strong>
          atelier<%= "s" if @report.workshops_undistributed_count > 1 %>
          de cette période <strong>ne sont répartis à personne</strong> : le taux des ateliers n'est
          pas défini à leur date, ou aucun animateur n'a été sélectionné. Leur recette est comptée
          dans le total ci-dessous mais ne verse rien.
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Date</th>
            <th>Atelier</th>
            <th>Animateurs</th>
            <th class="text-right">Recette</th>
            <th class="text-right">Les 4 Sources</th>
            <th class="text-right">Boulangers</th>
          </tr>
        </thead>
        <tbody>
          <% @report.workshops.each do |entry| %>
            <%# Un atelier non réparti est teinté : sa recette compte dans le
                total mais ne verse rien à personne. %>
            <tr style="<%= "background: var(--warning-100);" unless entry.distributed? %>">
              <td class="adm-grid-num whitespace-nowrap" style="color: var(--text-strong);"><%= l(entry.date) %></td>
              <td style="color: var(--text-strong);"><%= entry.workshop.title %></td>
              <td>
                <% if entry.unassigned %>
                  <%= adm_chip "Aucun animateur", tone: :warning %>
                <% else %>
                  <%= entry.workshop.artisans.map(&:name).join(", ") %>
                <% end %>
              </td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(entry.revenue_cents) %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);">
                <% if entry.rate_undefined? %>
                  <%= adm_chip "taux non défini", tone: :warning %>
                <% else %>
                  <%= reports_currency(entry.four_sources_cents) %>
                <% end %>
              </td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);">
                <% if entry.distributed? %>
                  <%= reports_currency(entry.bakers_cents) %>
                <% else %>
                  <%= adm_chip "non réparti", tone: :warning %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="adm-grid-total">
            <td colspan="3">Total ateliers</td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.total_workshop_revenue_cents) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.total_workshop_four_sources_cents) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.total_workshop_bakers_cents) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>
<% end %>

<%# Revenu final par artisan (après mise en commun des partenariats) %>
<section class="adm-card mb-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Revenu par boulanger (à verser sur la période)</h2>
    <span class="adm-eyebrow"><%= @report.artisan_settlements.size %> boulanger<%= "s" if @report.artisan_settlements.size > 1 %></span>
  </div>

  <p class="px-4 pt-4 text-sm" style="color: var(--text-muted);">
    « Part finale » = ce qui est dû à chaque boulanger, tous postes confondus — c'est la
    colonne à reporter en comptabilité. Les quatre colonnes qui la précèdent disent d'où
    vient l'argent : le pain, les pizza parties privées, les pizza parties publiques
    (site et BilletWeb), les ateliers. Leur somme fait toujours la part finale. Pour les
    membres d'un partenariat, chaque poste est mis en commun puis réparti à parts égales.
  </p>

  <div class="mt-4 overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Boulanger</th>
          <th>Partenariat</th>
          <th>Jours</th>
          <th class="text-right">Pain</th>
          <th class="text-right">Party privée</th>
          <th class="text-right">Party publique</th>
          <th class="text-right">Ateliers</th>
          <th class="text-right">Part brute (ses jours)</th>
          <th class="text-right">Part finale</th>
        </tr>
      </thead>
      <tbody>
        <% if @report.artisan_settlements.empty? %>
          <%= adm_empty_row(colspan: 9,
                            title: "Aucun boulanger affecté à un jour de production sur la période.",
                            hint: "Affectez des artisans aux jours de cuisson pour voir leur revenu ici.") %>
        <% end %>

        <% @report.artisan_settlements.each do |settlement| %>
          <tr>
            <td class="font-medium" style="color: var(--text-strong);"><%= settlement.artisan.name %></td>
            <td>
              <% if settlement.partnership %>
                <%= adm_chip settlement.partnership.name, tone: :water %>
              <% else %>
                <span style="color: var(--text-faint);">—</span>
              <% end %>
            </td>
            <td class="adm-grid-num"><%= settlement.days_count %></td>
            <%# Un zéro à toutes les lignes d'une colonne est du bruit : on le
                grise pour que l'oeil n'aille qu'aux postes qui versent. %>
            <% BakerRevenueService::BUCKETS.each do |bucket| %>
              <% cents = settlement.public_send(bucket) %>
              <td class="adm-grid-num text-right" style="color: <%= cents.zero? ? "var(--text-faint)" : "var(--text-body)" %>;">
                <%= reports_currency(cents) %>
              </td>
            <% end %>
            <td class="adm-grid-num text-right"><%= reports_currency(settlement.raw_cents) %></td>
            <td class="adm-grid-num text-right font-semibold" style="color: var(--text-strong);"><%= reports_currency(settlement.settled_cents) %></td>
          </tr>
        <% end %>
      </tbody>

      <% if @report.artisan_settlements.any? %>
        <tfoot>
          <tr class="adm-grid-total">
            <td colspan="3">Total pool boulangers</td>
            <% BakerRevenueService::BUCKETS.each do |bucket| %>
              <td class="adm-grid-num text-right">
                <%= reports_currency(@report.artisan_settlements.sum { |s| s.public_send(bucket) }) %>
              </td>
            <% end %>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.artisan_settlements.sum(&:raw_cents)) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.artisan_settlements.sum(&:settled_cents)) %></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
</section>

<%# Détail par jour de production %>
<section class="adm-card mb-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Détail par jour de production</h2>
    <span class="adm-eyebrow"><%= @report.days.size %> jour<%= "s" if @report.days.size > 1 %></span>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Jour</th>
          <th class="text-right">CA</th>
          <th class="text-right">Coûtant</th>
          <th class="text-right">Sacs</th>
          <th class="text-right">Transport</th>
          <th class="text-right">Commissions</th>
          <th class="text-right">Lieux de vente</th>
          <th class="text-right">Marge brute</th>
          <th class="text-right">Part 4S</th>
          <th class="text-right">Pool</th>
          <th>Revenu par boulanger</th>
        </tr>
      </thead>
      <tbody>
        <% if @report.days.empty? %>
          <%= adm_empty_row(colspan: 11,
                            title: "Aucun jour de production sur la période sélectionnée.",
                            hint: "Élargissez la période pour retrouver des fournées.") %>
        <% end %>

        <% @report.days.each do |day| %>
          <%# Un jour dont les parts dépassent 100 % est teinté : son pool est
              sur-réparti, le total ne veut plus rien dire tel quel. %>
          <tr style="<%= "background: var(--warning-100);" if day.percent_overflow %>">
            <td class="adm-grid-num whitespace-nowrap font-medium" style="color: var(--text-strong);"><%= l(day.date) %></td>
            <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(day.revenue_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(day.cost_price_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(day.bread_bags_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(day.transport_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(day.commission_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(day.sales_locations_cents) %></td>
            <td class="adm-grid-num text-right font-semibold" style="color: var(--text-strong);"><%= reports_currency(day.gross_margin_cents) %></td>
            <td class="adm-grid-num text-right" style="color: var(--success-700);"><%= reports_currency(day.four_sources_cents) %></td>
            <td class="adm-grid-num text-right" style="color: var(--water-700);"><%= reports_currency(day.baker_pool_cents) %></td>
            <td>
              <% if day.artisan_shares.any? %>
                <ul class="space-y-0.5">
                  <% day.artisan_shares.each do |share| %>
                    <li>
                      <%= share.artisan.name %> —
                      <% if share.percent.nil? %>
                        <span style="color: var(--warning-700);">part non configurée</span>
                      <% else %>
                        <%= reports_currency(share.amount_cents) %>
                        <span style="color: var(--text-faint);">(<%= number_with_precision(share.percent, strip_insignificant_zeros: true) %> %)</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
                <% if day.percent_overflow %>
                  <p class="mt-1 text-xs" style="color: var(--warning-700);">⚠ Somme des parts &gt; 100 %</p>
                <% end %>
              <% else %>
                <span style="color: var(--text-faint);">Aucun boulanger affecté</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>

      <% if @report.days.any? %>
        <tfoot>
          <tr class="adm-grid-total">
            <td>Total</td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.total_revenue_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(@report.total_cost_price_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(@report.total_bread_bags_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(@report.total_transport_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(@report.total_commission_cents) %></td>
            <td class="adm-grid-num text-right">- <%= reports_currency(@report.total_sales_locations_cents) %></td>
            <td class="adm-grid-num text-right"><%= reports_currency(@report.gross_margin_cents) %></td>
            <td class="adm-grid-num text-right" style="color: var(--success-700);"><%= reports_currency(@report.four_sources_cents) %></td>
            <td class="adm-grid-num text-right" style="color: var(--water-700);"><%= reports_currency(@report.baker_pool_cents) %></td>
            <td></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
</section>
