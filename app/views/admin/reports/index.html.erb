<% content_for :title, "Reporting" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Reporting" do %>
  <%= link_to "Revenus des boulangers",
              baker_revenue_admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
  <%= link_to "Versements Stripe",
              payouts_admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
  <%= link_to "Pizza parties privées",
              pizza_parties_admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
<% end %>

<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">
  Période du <%= l(@start_date) %> au <%= l(@end_date) %>
</p>

<div class="adm-card mb-4 p-3 sm:p-4">
  <%= render "date_range_filter", start_date: @start_date, end_date: @end_date %>
</div>

<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Chiffre d'affaires</p>
    <p class="adm-grid-num mt-1 text-3xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@revenue_cents) %></p>
    <p class="mt-1 text-sm" style="color: var(--text-muted);">Commandes prises en compte : <%= @orders_count %></p>
  </div>
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Panier moyen</p>
    <p class="adm-grid-num mt-1 text-3xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@average_order_value_cents) %></p>
    <p class="mt-1 text-sm" style="color: var(--text-muted);">Calculé sur les commandes payées, prêtes ou récupérées</p>
  </div>
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Produits suivis</p>
    <p class="adm-grid-num mt-1 text-3xl font-bold" style="color: var(--text-strong);"><%= @sales_by_product.size %></p>
    <p class="mt-1 text-sm" style="color: var(--text-muted);">Nombre de produits vendus sur la période</p>
  </div>
</div>

<section class="adm-card mb-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Commissions Stripe &amp; CA net</h2>
  </div>

  <div class="p-4">
    <p class="mb-4 text-sm" style="color: var(--text-muted);">
      Commissions prélevées par Stripe sur les commandes payées en ligne. Les paiements par portefeuille ou hors ligne n'engendrent pas de commission.
    </p>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div>
        <dt class="adm-eyebrow">CA brut</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@revenue_cents) %></dd>
      </div>
      <div>
        <dt class="adm-eyebrow">Commissions Stripe</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--danger-700);">- <%= reports_currency(@total_stripe_fees_cents) %></dd>
        <dd class="mt-1 text-sm" style="color: var(--text-muted);"><%= revenue_share(@total_stripe_fees_cents, @revenue_cents) %> % du CA brut</dd>
        <% if @refund_stripe_fees_cents.positive? %>
          <dd class="mt-1 text-sm" style="color: var(--text-muted);">
            dont <%= reports_currency(@refund_stripe_fees_cents) %> non remboursés sur remboursements
          </dd>
        <% end %>
      </div>
      <div>
        <dt class="adm-eyebrow">CA net</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@net_revenue_cents) %></dd>
        <dd class="mt-1 text-sm" style="color: var(--text-muted);">Après commissions Stripe (ventes et remboursements)</dd>
      </div>
    </dl>
  </div>
</section>

<section class="adm-card mb-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Remboursements</h2>
    <%= link_to "Voir le détail →",
                refunds_admin_reports_path(start_date: @start_date, end_date: @end_date),
                class: "adm-link text-sm" %>
  </div>

  <div class="p-4">
    <p class="mb-4 text-sm" style="color: var(--text-muted);">
      Remboursements Stripe (commandes annulées remboursées) et remboursements vers le portefeuille
      sur la période, ventilés par jour de cuisson de la commande. Les commandes remboursées sont
      exclues du chiffre d'affaires.
    </p>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <dt class="adm-eyebrow">Remboursements</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);">
          <%= link_to @refunds[:count],
                      refunds_admin_reports_path(start_date: @start_date, end_date: @end_date),
                      class: "underline decoration-dotted", style: "color: inherit;" %>
        </dd>
        <dd class="mt-1 text-sm" style="color: var(--text-muted);">
          <%= @refunds[:stripe][:count] %> Stripe · <%= @refunds[:wallet][:count] %> portefeuille
        </dd>
      </div>
      <div>
        <dt class="adm-eyebrow">Montant total remboursé</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@refunds[:amount_cents]) %></dd>
        <dd class="mt-1 text-sm" style="color: var(--text-muted);">Stripe + portefeuille</dd>
      </div>
      <div>
        <dt class="adm-eyebrow">Remboursé via Stripe</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@refunds[:stripe][:amount_cents]) %></dd>
        <dd class="mt-1 text-sm" style="color: var(--danger-700);">
          commission non récupérée : <%= reports_currency(@refunds[:stripe][:stripe_fee_cents]) %>
        </dd>
      </div>
      <div>
        <dt class="adm-eyebrow">Remboursé sur portefeuille</dt>
        <dd class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@refunds[:wallet][:amount_cents]) %></dd>
        <dd class="mt-1 text-sm" style="color: var(--text-muted);">Crédité au portefeuille client</dd>
      </div>
    </dl>
  </div>
</section>

<div class="mb-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
  <section class="adm-card overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Ventes par produit</h2>
      <span class="adm-eyebrow">CA net, remises déduites</span>
    </div>

    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Produit</th>
            <th class="text-right">Quantité</th>
            <th class="text-right">CA</th>
            <th class="text-right">Part</th>
          </tr>
        </thead>
        <tbody>
          <% if @sales_by_product.empty? %>
            <%= adm_empty_row(colspan: 4,
                              title: "Aucune vente enregistrée sur cette période.",
                              hint: "Élargissez la période pour retrouver des fournées vendues.") %>
          <% end %>

          <% @sales_by_product.each do |entry| %>
            <tr>
              <td style="color: var(--text-strong);"><%= entry[:product_name] %></td>
              <td class="adm-grid-num text-right"><%= entry[:total_quantity] %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(entry[:total_cents]) %></td>
              <td class="adm-grid-num text-right"><%= revenue_share(entry[:total_cents], @revenue_cents) %> %</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="adm-card overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Top 10 des clients</h2>
    </div>

    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Client</th>
            <th class="text-right">Commandes</th>
            <th class="text-right">CA</th>
          </tr>
        </thead>
        <tbody>
          <% if @top_customers.empty? %>
            <%= adm_empty_row(colspan: 3,
                              title: "Aucun client éligible pour cette période.",
                              hint: "Seules les commandes payées, prêtes ou récupérées comptent.") %>
          <% end %>

          <% @top_customers.each do |entry| %>
            <tr>
              <td style="color: var(--text-strong);"><%= entry[:customer_name].presence || "Client anonyme" %></td>
              <td class="adm-grid-num text-right"><%= entry[:orders_count] %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(entry[:total_cents]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<section class="adm-card mb-4 overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Ventes par catégorie interne</h2>
    <span class="adm-eyebrow">Production maison vs reventes</span>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Catégorie</th>
          <th class="text-right">Commandes</th>
          <th class="text-right">Quantité</th>
          <th class="text-right">CA</th>
          <th class="text-right">Part</th>
        </tr>
      </thead>
      <tbody>
        <% if @sales_by_internal_category.empty? %>
          <%= adm_empty_row(colspan: 5,
                            title: "Aucune vente enregistrée sur cette période.",
                            hint: "Élargissez la période pour retrouver des fournées vendues.") %>
        <% end %>

        <% @sales_by_internal_category.each do |entry| %>
          <tr>
            <td style="color: var(--text-strong);"><%= product_internal_category_heading(entry[:internal_category]) %></td>
            <td class="adm-grid-num text-right"><%= entry[:orders_count] %></td>
            <td class="adm-grid-num text-right"><%= entry[:total_quantity] %></td>
            <td class="adm-grid-num text-right" style="color: var(--text-strong);"><%= reports_currency(entry[:total_cents]) %></td>
            <td class="adm-grid-num text-right"><%= revenue_share(entry[:total_cents], @revenue_cents) %> %</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
  <section class="adm-card overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Comparaison mardi vs vendredi</h2>
    </div>

    <div class="p-4">
      <% if @weekday_comparison.any? %>
        <div class="mb-4 text-sm" style="color: var(--text-body);">
          <% @weekday_comparison.each do |entry| %>
            <p>
              <span class="font-medium" style="color: var(--text-strong);"><%= weekday_label(entry[:weekday]) %></span> :
              <%= entry[:orders_count] %> commandes — <%= reports_currency(entry[:total_cents]) %>
            </p>
          <% end %>
        </div>
        <% weekday_config = weekday_sales_chart_config(@weekday_comparison) %>
        <canvas
          data-controller="reports"
          data-reports-config-value="<%= chart_config_json(weekday_config) %>"
          class="h-64 w-full">
        </canvas>
      <% else %>
        <p class="text-sm" style="color: var(--text-muted);">Pas encore de ventes pour comparer ces deux jours.</p>
      <% end %>
    </div>
  </section>

  <section class="adm-card overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Ventes par mois</h2>
    </div>

    <div class="p-4">
      <% if @monthly_sales.any? %>
        <div class="mb-4 text-sm" style="color: var(--text-body);">
          <ul class="space-y-1">
            <% @monthly_sales.each do |entry| %>
              <li>
                <span class="font-medium" style="color: var(--text-strong);"><%= month_label(entry[:month]) %></span> :
                <%= entry[:orders_count] %> commandes — <%= reports_currency(entry[:total_cents]) %>
              </li>
            <% end %>
          </ul>
        </div>
        <% monthly_config = monthly_sales_chart_config(@monthly_sales) %>
        <canvas
          data-controller="reports"
          data-reports-config-value="<%= chart_config_json(monthly_config) %>"
          class="h-64 w-full">
        </canvas>
      <% else %>
        <p class="text-sm" style="color: var(--text-muted);">Pas encore de ventes pour cette période.</p>
      <% end %>
    </div>
  </section>
</div>
