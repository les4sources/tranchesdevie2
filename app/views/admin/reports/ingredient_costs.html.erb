<% content_for :title, "Coût des matières premières" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Coût des matières premières" %>

<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">
  Chaque quantité est valorisée <strong>au prix en vigueur à la date de sa fournée</strong>, jamais au prix
  d'aujourd'hui. Changer un prix aujourd'hui ne modifie donc aucun chiffre de ce tableau pour une période passée.
</p>

<div class="adm-card mb-4 p-3 sm:p-4">
  <%= render "date_range_filter", url: ingredient_costs_admin_reports_path, start_date: @start_date, end_date: @end_date %>
</div>

<div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div class="adm-card p-4">
    <p class="adm-eyebrow">Coût total valorisé</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@costs.total_cost_cents) %></p>
  </div>
  <div class="adm-card p-4" style="<%= "border-color: var(--warning-200);" if @costs.unpriced_count.positive? %>">
    <p class="adm-eyebrow" style="<%= "color: var(--warning-700);" if @costs.unpriced_count.positive? %>">Éléments sans prix</p>
    <p class="adm-grid-num mt-1 text-2xl font-bold"
       style="color: <%= @costs.unpriced_count.positive? ? "var(--warning-700)" : "var(--text-strong)" %>;">
      <%= @costs.unpriced_count %>
    </p>
    <p class="mt-1 text-xs" style="color: var(--text-muted);">Leur quantité est affichée, mais elle n'est pas valorisée — jamais comptée pour zéro.</p>
  </div>
</div>

<% [ [ "Ingrédients", @costs.ingredient_lines ], [ "Farines", @costs.flour_lines ] ].each do |title, lines| %>
  <div class="adm-card mb-4 overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);"><%= title %></h2>
      <span class="adm-eyebrow"><%= lines.size %> ligne<%= "s" if lines.size > 1 %></span>
    </div>

    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Élément</th>
            <th class="text-right">Quantité</th>
            <th class="text-right">Coût valorisé</th>
            <th>Prix</th>
          </tr>
        </thead>
        <tbody>
          <% if lines.empty? %>
            <%= adm_empty_row(colspan: 4,
                              title: "Aucune consommation sur la période.",
                              hint: "Élargissez la période pour voir des fournées.") %>
          <% end %>

          <% lines.each do |line| %>
            <%# Une ligne partiellement valorisée est signalée par sa teinte : le
                total qu'elle affiche est incomplet, il ne faut pas s'y fier seul. %>
            <tr style="<%= "background: var(--warning-100);" if line.partially_priced? %>">
              <td style="color: var(--text-strong);"><%= line.subject.name %></td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);">
                <%= number_with_precision(line.kilos, precision: 3, strip_insignificant_zeros: true) %> kg
              </td>
              <td class="adm-grid-num text-right" style="color: var(--text-strong);">
                <% if line.priced? %>
                  <%= reports_currency(line.cost_cents) %>
                <% else %>
                  <%= adm_chip "non valorisé", tone: :warning %>
                <% end %>
              </td>
              <td class="text-xs" style="color: var(--text-muted);">
                <% if line.partially_priced? %>
                  <span style="color: var(--warning-700);">
                    <%= number_with_precision(line.missing_price_grams / 1000.0, precision: 3, strip_insignificant_zeros: true) %> kg sans prix à leur date
                  </span>
                <% else %>
                  Valorisé au prix de chaque fournée
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
