<% content_for :title, "Versements Stripe" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Versements Stripe" do %>
  <%= link_to "← Retour au reporting",
              admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
<% end %>

<p class="-mt-2 text-sm" style="color: var(--text-muted);">
  Période du <%= l(@start_date) %> au <%= l(@end_date) %>
</p>

<p class="mt-1 max-w-2xl text-xs" style="color: var(--text-faint);">
  Deux lectures complémentaires : les <strong>versements</strong> réellement reçus en banque
  (source Stripe) et l'<strong>activité en ligne</strong> de la période (nos commandes payées en
  ligne). Les deux totaux ne s'égalisent pas au centime : axes de temps différents (date d'arrivée
  du versement vs jour de cuisson) et les recharges de portefeuille passent aussi par les versements.
</p>

<div class="adm-card my-4 p-3 sm:p-4">
  <%= render "date_range_filter", start_date: @start_date, end_date: @end_date %>
</div>

<% if @report.error.present? %>
  <div class="adm-card mb-4 p-4" style="border-color: var(--danger-200); background: var(--danger-100);">
    <p class="text-sm font-medium" style="color: var(--danger-700);"><%= @report.error %></p>
  </div>
<% end %>

<% unless @report.error.present? %>
  <%# ── Section 1 : Versements Stripe (ce qui est tombé en banque) ───────────── %>
  <section class="adm-card mb-6 overflow-hidden">
    <div class="adm-cardhd">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Versements reçus en banque</h2>
      <div class="text-right">
        <p class="adm-eyebrow">Net total versé</p>
        <p class="adm-grid-num text-xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.total_net_paid_cents) %></p>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="adm-grid">
        <thead>
          <tr>
            <th>Date d'arrivée</th>
            <th>Versement</th>
            <th>Statut</th>
            <th class="text-right">Net versé</th>
          </tr>
        </thead>
        <tbody>
          <% if @report.payouts.empty? %>
            <%= adm_empty_row(colspan: 4,
                              title: "Aucun versement Stripe sur cette période.",
                              hint: "Stripe verse par lots : élargissez la période pour retrouver le lot précédent.") %>
          <% end %>

          <% @report.payouts.each do |payout| %>
            <tr>
              <td class="adm-grid-num whitespace-nowrap" style="color: var(--text-strong);">
                <%= payout.arrival_date ? l(payout.arrival_date) : "—" %>
              </td>
              <td class="whitespace-nowrap font-mono text-xs" style="color: var(--text-muted);"><%= payout.stripe_id %></td>
              <td class="whitespace-nowrap"><%= adm_payout_status_chip(payout.status) %></td>
              <td class="adm-grid-num whitespace-nowrap text-right font-semibold" style="color: var(--text-strong);">
                <%= reports_currency(payout.net_cents) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ── Section 2 : Activité en ligne de la période (notre base) ─────────────── %>
  <section>
    <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
      <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Activité en ligne de la période</h2>
      <span class="adm-eyebrow"><%= @report.period_orders_count %> commande<%= "s" if @report.period_orders_count > 1 %> en ligne</span>
    </div>

    <div class="mb-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="adm-card p-4">
        <p class="adm-eyebrow">Brut ventes en ligne</p>
        <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.period_gross_cents) %></p>
      </div>
      <div class="adm-card p-4" style="border-color: var(--danger-200);">
        <p class="adm-eyebrow" style="color: var(--danger-700);">Frais Stripe</p>
        <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--danger-700);">- <%= reports_currency(@report.period_fee_cents) %></p>
      </div>
      <div class="adm-card p-4">
        <p class="adm-eyebrow">Net</p>
        <p class="adm-grid-num mt-1 text-2xl font-bold" style="color: var(--text-strong);"><%= reports_currency(@report.period_net_cents) %></p>
      </div>
    </div>

    <div class="adm-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="adm-grid">
          <thead>
            <tr>
              <th>Commande</th>
              <th>Client</th>
              <th>Jour de cuisson</th>
              <th class="text-right">Montant</th>
              <th class="text-right">Frais</th>
            </tr>
          </thead>
          <tbody>
            <% if @report.period_orders.empty? %>
              <%= adm_empty_row(colspan: 5,
                                title: "Aucune commande en ligne finalisée sur cette période.",
                                hint: "Les paiements par portefeuille ou hors ligne n'apparaissent pas ici.") %>
            <% end %>

            <% @report.period_orders.each do |line| %>
              <tr>
                <td class="adm-grid-num whitespace-nowrap font-semibold">
                  <%= link_to line.order_number, admin_order_path(line.order), class: "adm-link" %>
                </td>
                <td class="whitespace-nowrap" style="color: var(--text-strong);"><%= line.customer_name.presence || "—" %></td>
                <td class="adm-grid-num whitespace-nowrap"><%= line.baked_on ? l(line.baked_on) : "—" %></td>
                <td class="adm-grid-num whitespace-nowrap text-right font-medium" style="color: var(--text-strong);">
                  <%= reports_currency(line.amount_cents) %>
                </td>
                <td class="adm-grid-num whitespace-nowrap text-right" style="color: var(--danger-700);">
                  - <%= reports_currency(line.fee_cents) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% end %>
