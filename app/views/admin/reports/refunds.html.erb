<% content_for :title, "Détail des remboursements" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Détail des remboursements" do %>
  <%= link_to "← Retour au reporting",
              admin_reports_path(start_date: @start_date, end_date: @end_date),
              class: adm_btn_class(:default) %>
<% end %>

<p class="-mt-2 mb-4 text-sm" style="color: var(--text-muted);">
  Période du <%= l(@start_date) %> au <%= l(@end_date) %>
</p>

<div class="adm-card overflow-hidden">
  <div class="adm-cardhd">
    <h2 class="text-sm font-semibold" style="color: var(--text-strong);">Remboursements</h2>
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <span class="adm-eyebrow"><%= @refunds_summary[:count] %> remboursement(s)</span>
      <span class="adm-eyebrow">Montant total : <%= reports_currency(@refunds_summary[:amount_cents]) %></span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="adm-grid">
      <thead>
        <tr>
          <th>Date</th>
          <th>Client</th>
          <th>Commande</th>
          <th>Type</th>
          <th class="text-right">Montant remboursé</th>
          <th>Motif</th>
        </tr>
      </thead>
      <tbody>
        <% if @refund_details.empty? %>
          <%= adm_empty_row(colspan: 6,
                            title: "Aucun remboursement sur cette période.",
                            hint: "Élargissez la période pour retrouver des remboursements plus anciens.") %>
        <% end %>

        <% @refund_details.each do |refund| %>
          <tr>
            <td class="adm-grid-num whitespace-nowrap"><%= refund[:refunded_at].in_time_zone.strftime("%d/%m/%Y %H:%M") %></td>
            <td class="whitespace-nowrap" style="color: var(--text-strong);"><%= refund[:customer_name] %></td>
            <td class="whitespace-nowrap">
              <%= link_to refund[:order].order_number, admin_order_path(refund[:order]), class: "adm-link" %>
            </td>
            <td class="whitespace-nowrap">
              <%= adm_chip(refund[:source] == :stripe ? "Stripe" : "Portefeuille",
                           tone: refund[:source] == :stripe ? :water : :accent) %>
            </td>
            <td class="adm-grid-num whitespace-nowrap text-right font-medium" style="color: var(--text-strong);">
              <%= reports_currency(refund[:amount_cents]) %>
            </td>
            <td style="color: var(--text-muted);"><%= refund[:reason].presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
