<%# Variante « fournil » : à gauche, les photos de la boulangerie défilent
    lentement (fondu + travelling, CSS seul) ; à droite, une feuille couleur
    farine avec un salut qui suit l'heure du jour. %>
<% greeting, whisper = admin_login_greeting %>
<% slides = [
     [ "tranches-de-vie-5.jpg", "Sur les clayettes", "Épeautre, seigle, froment." ],
     [ "tranches-de-vie-2.jpg", "Sortie de four", "Les miches refroidissent sous l'auvent." ],
     [ "tranches-de-vie-3.jpg", "Le four à bois", "Chêne, braise et patience." ],
     [ "tranches-de-vie-1.jpg", "Le geste", "La pâte coule, le pétrin attend." ],
     [ "tranches-de-vie-4.jpg", "Pétrir ensemble", "Un atelier sous le figuier." ]
   ] %>

<div class="lgf" data-controller="admin-login">
  <section class="lgf-visual" aria-hidden="true">
    <% slides.each_with_index do |(image, _, _), i| %>
      <div class="lgf-slide" style="--i: <%= i %>; background-image: url('<%= image_path(image) %>');"></div>
    <% end %>
    <div class="lgf-veil"></div>

    <div class="lgf-brand tdv-script">Tranches de Vie</div>

    <div class="lgf-captions">
      <% slides.each_with_index do |(_, title, line), i| %>
        <div class="lgf-caption" style="--i: <%= i %>;">
          <span class="lgf-caption-index"><%= format("%02d", i + 1) %> — <%= format("%02d", slides.size) %></span>
          <span class="lgf-caption-title"><%= title %></span>
          <span class="lgf-caption-line"><%= line %></span>
        </div>
      <% end %>
      <div class="lgf-progress">
        <% slides.size.times do |i| %>
          <span style="--i: <%= i %>;"><i></i></span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="lgf-panel">
    <header class="lgf-top lgf-rise" style="--d: 0">
      <span class="lgf-mark tdv-script">Tranches de Vie</span>
      <span class="lgf-eyebrow"><%= lucide "wheat", size: 14 %> Espace boulangers</span>
    </header>

    <div class="lgf-body">
      <p class="lgf-eyebrow lgf-rise" style="--d: 1">Le fournil · Les 4 Sources, Yvoir</p>
      <h1 class="lgf-title lgf-rise" style="--d: 2"><%= greeting %><span>.</span></h1>
      <p class="lgf-whisper lgf-rise" style="--d: 3"><%= whisper %></p>

      <% if (next_bake = admin_login_next_bake(@next_bake_day)) %>
        <p class="lgf-next lgf-rise" style="--d: 4">
          <%= lucide "flame", size: 15 %>
          Prochaine fournée&nbsp;: <strong><%= next_bake %></strong>
        </p>
      <% end %>

      <%= form_with url: admin_login_path, local: true, class: "lgf-form lgf-rise", style: "--d: 5", data: { action: "submit->admin-login#submit" } do |f| %>
        <%= hidden_field_tag :variante, "fournil" %>

        <% if alert %>
          <p class="lgf-alert" role="alert"><%= lucide "alert-triangle", size: 15 %> <%= alert %>. La pâte n'a pas levé, réessaie.</p>
        <% elsif notice %>
          <p class="lgf-notice"><%= lucide "check", size: 15 %> <%= notice %></p>
        <% end %>

        <label for="password" class="lgf-label">Mot de passe du fournil</label>
        <div class="lgf-field <%= 'is-error' if alert %>">
          <%= f.password_field :password, id: "password", required: true, autofocus: true,
                autocomplete: "current-password", placeholder: "••••••••••",
                data: { admin_login_target: "input" } %>
          <button type="button" class="lgf-eye" data-action="admin-login#toggle" aria-label="Afficher le mot de passe" data-admin-login-target="eye">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.06 12.35a1 1 0 0 1 0-.7 10.75 10.75 0 0 1 19.88 0 1 1 0 0 1 0 .7 10.75 10.75 0 0 1-19.88 0"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>

        <button type="submit" class="lgf-submit" data-admin-login-target="button">
          <span>Entrer au fournil</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      <% end %>
    </div>

    <footer class="lgf-foot lgf-rise" style="--d: 6">
      Pain au levain, pétri à la main, cuit au feu de bois.
    </footer>
  </section>
</div>
