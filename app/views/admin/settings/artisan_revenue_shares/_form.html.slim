= form_with model: revenue_share, url: (revenue_share.persisted? ? admin_settings_artisan_revenue_share_path(@artisan, revenue_share) : admin_settings_artisan_revenue_shares_path(@artisan)), method: (revenue_share.persisted? ? :patch : :post), local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if revenue_share.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - revenue_share.errors.full_messages.each do |message|
          li= message

  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .space-y-2
      = f.label :percent, "Part (%)", class: "adm-eyebrow block"
      = f.number_field :percent, step: "0.001", min: 0, required: true, class: adm_field_class
    .space-y-2
      = f.label :active_from, "À partir du", class: "adm-eyebrow block"
      = f.date_field :active_from, class: adm_field_class

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_artisan_revenue_shares_path(@artisan), class: adm_btn_class(:ghost)
    = f.submit revenue_share.persisted? ? "Mettre à jour" : "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
