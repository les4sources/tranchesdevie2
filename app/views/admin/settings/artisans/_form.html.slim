= form_with model: [:admin, :settings, artisan], local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if artisan.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - artisan.errors.full_messages.each do |message|
          li= message

  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .space-y-2
      = f.label :name, "Nom", class: "adm-eyebrow block"
      = f.text_field :name, required: true, class: adm_field_class
    .space-y-2
      label.flex.items-center.gap-2.cursor-pointer
        = f.check_box :active, style: "accent-color: var(--brand);"
        span.text-sm.font-medium style="color: var(--text-body);" Artisan actif (apparaît dans les choix des jours de cuisson)

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_artisans_path, class: adm_btn_class(:ghost)
    = f.submit artisan.persisted? ? "Mettre à jour" : "Créer l'artisan", class: adm_btn_class(:primary, "cursor-pointer")
