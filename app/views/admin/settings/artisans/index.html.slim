- content_for :title, "Artisans"
- content_for :layout, "admin"

= adm_page_header "Artisans" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_artisan_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouvel artisan

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Tous les artisans
    span.adm-eyebrow = "#{@artisans.size} artisan#{'s' if @artisans.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th Nom
          th Actif
          th Actions
      tbody
        - if @artisans.any?
          - @artisans.each do |artisan|
            tr
              td.font-medium style="color: var(--text-strong);" = artisan.name
              td
                - if artisan.active?
                  = adm_chip "Oui", tone: :success
                - else
                  = adm_chip "Inactif", tone: :neutral
              td.whitespace-nowrap
                = link_to "Modifier", edit_admin_settings_artisan_path(artisan), class: "adm-rowaction mr-3"
                = link_to "Parts de revenu", admin_settings_artisan_revenue_shares_path(artisan), class: "adm-rowaction"
        - else
          = adm_empty_row colspan: 3, title: "Aucun artisan enregistré", hint: "Un artisan est un boulanger assignable à un jour de cuisson." do
            = link_to "Nouvel artisan", new_admin_settings_artisan_path, class: adm_btn_class(:primary)
