- content_for :title, "Farines"
- content_for :layout, "admin"

= adm_page_header "Farines" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_flour_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouvelle farine

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Toutes les farines
    span.adm-eyebrow = "#{@flours.size} farine#{'s' if @flours.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th.text-right Position
          th Nom
          th Levain
          th Moulin
          th Raffinage
          th.text-right Prix/kg
          th.text-right Limite pétrin
          th.text-right Ratios
          th.text-right Produits
          th Actions
      tbody
        - if @flours.any?
          - @flours.each do |flour|
            tr
              td.adm-grid-num.text-right = flour.position
              td.font-medium style="color: var(--text-strong);" = flour.name
              td = flour.levain_type&.capitalize
              td = flour.origin
              td = flour.grade
              td.adm-grid-num.whitespace-nowrap.text-right
                - if flour.price_per_kg_euros_on.present?
                  = number_to_currency(flour.price_per_kg_euros_on, unit: "€", separator: ",", delimiter: "")
              td.adm-grid-num.whitespace-nowrap.text-right
                - if flour.kneader_limit_grams.present?
                  = "#{flour.kneader_limit_grams / 1000} kg"
              / Une recette qui boucle totalise 100 % : on signale l'écart plutôt
              / que de le laisser passer inaperçu dans la colonne.
              td.adm-grid-num.text-right
                - margin = flour.panification_margin_percent
                - ratio_tone = margin.negative? ? :danger : (margin > 10 ? :warning : nil)
                - ratio_label = "#{number_with_precision(flour.panification_ratios_sum * 100, precision: 1, strip_insignificant_zeros: true)} %"
                - if ratio_tone
                  span.adm-tonetext.font-semibold class="adm-tone-#{ratio_tone}" = ratio_label
                - else
                  = ratio_label
              td.adm-grid-num.text-right = flour.product_flours.count
              td.whitespace-nowrap
                = link_to "Prix", admin_settings_flour_kilo_prices_path(flour), class: "adm-rowaction mr-3"
                = link_to "Modifier", edit_admin_settings_flour_path(flour), class: "adm-rowaction mr-3"
                = button_to "Supprimer", admin_settings_flour_path(flour), method: :delete, data: { turbo_confirm: "Supprimer cette farine ?" }, class: "adm-rowaction", form: { class: "inline" }
        - else
          = adm_empty_row colspan: 10, title: "Aucune farine définie", hint: "Une farine porte son ratio de panification, sa limite de pétrin et son prix au kilo." do
            = link_to "Nouvelle farine", new_admin_settings_flour_path, class: adm_btn_class(:primary)
