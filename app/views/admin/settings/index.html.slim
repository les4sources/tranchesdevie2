- content_for :title, "Paramètres"
- content_for :layout, "admin"

= adm_page_header "Paramètres"

.grid.grid-cols-1.gap-3.md:grid-cols-2
  = render "entry", path: admin_settings_flours_path, icon: "wheat", label: "Farines", hint: "Ratios de panification, limite du pétrin, prix au kilo."
  = render "entry", path: admin_settings_artisans_path, icon: "user-round", label: "Artisans", hint: "Les boulangers assignables à un jour de cuisson."
  = render "entry", path: admin_settings_revenue_partnerships_path, icon: "users", label: "Partenariats de revenu", hint: "Mise en commun du revenu entre boulangers, à parts égales."
  = render "entry", path: admin_settings_ingredients_path, icon: "salad", label: "Ingrédients", hint: "Garnitures et ingrédients, avec leur prix au kilo."
  = render "entry", path: admin_settings_mold_types_path, icon: "grip-horizontal", label: "Types de moules", hint: "Nombre de moules disponibles par jour de cuisson."
  = render "entry", path: admin_pickup_locations_path, icon: "map-pin", label: "Points de retrait", hint: "Les lieux où le mangeur vient chercher sa commande."
  = render "entry", path: edit_admin_settings_production_setting_path, icon: "flame", label: "Capacités de production", hint: "Capacité du four et créneaux de parties privées."
  = render "entry", path: edit_admin_settings_notification_setting_path, icon: "bell", label: "Notifications", hint: "Le message « commande prête », par SMS et par e-mail."
  = render "entry", path: admin_settings_revenue_parameters_path, icon: "badge-euro", label: "Revenus des boulangers", hint: "Transport et taux Les 4 Sources, historisés par date."
  = render "entry", path: admin_settings_sales_locations_path, icon: "shopping-basket", label: "Lieux de vente", hint: "Marchés et emplacements dont le coût est déduit du bénéfice."
