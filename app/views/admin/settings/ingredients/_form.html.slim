= form_with model: [:admin, :settings, ingredient], local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if ingredient.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - ingredient.errors.full_messages.each do |message|
          li= message

  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .space-y-2
      = f.label :name, "Nom", class: "adm-eyebrow block"
      = f.text_field :name, class: adm_field_class
    .space-y-2
      = f.label :position, "Position", class: "adm-eyebrow block"
      = f.number_field :position, class: adm_field_class

  .space-y-2
    span.adm-eyebrow.block Type d'unité
    .mt-2.space-y-2
      label.flex.items-center.gap-2.cursor-pointer
        = f.radio_button :unit_type, "weight", style: "accent-color: var(--brand);"
        span.text-sm.font-medium style="color: var(--text-body);" Poids (grammes)
      label.flex.items-center.gap-2.cursor-pointer
        = f.radio_button :unit_type, "piece", style: "accent-color: var(--brand);"
        span.text-sm.font-medium style="color: var(--text-body);" Pièces

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_ingredients_path, class: adm_btn_class(:ghost)
    = f.submit "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
