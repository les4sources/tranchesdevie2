- content_for :title, "Ingrédients"
- content_for :layout, "admin"

= adm_page_header "Ingrédients" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_ingredient_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouvel ingrédient

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Tous les ingrédients
    span.adm-eyebrow = "#{@ingredients.size} ingrédient#{'s' if @ingredients.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th.text-right Position
          th Nom
          th Unité
          th.text-right Prix / kg
          th.text-right Variantes
          th Actions
      tbody
        - if @ingredients.any?
          - @ingredients.each do |ingredient|
            tr
              td.adm-grid-num.text-right = ingredient.position
              td.font-medium style="color: var(--text-strong);" = ingredient.name
              td = ingredient.weight? ? "Poids (g)" : "Pièces"
              / Sans prix saisi, le coût est signalé comme inconnu — jamais
              / compté pour zéro : la pastille le dit à l'œil.
              td.adm-grid-num.text-right
                - price = ingredient.price_per_kg_euros_on
                - if price
                  = number_to_currency(price, unit: "€", separator: ",", delimiter: " ")
                - else
                  = adm_chip "aucun prix", tone: :warning
              td.adm-grid-num.text-right = ingredient.variant_ingredients.count
              td.whitespace-nowrap
                = link_to "Prix", admin_settings_ingredient_kilo_prices_path(ingredient), class: "adm-rowaction mr-3"
                = link_to "Modifier", edit_admin_settings_ingredient_path(ingredient), class: "adm-rowaction mr-3"
                = button_to "Supprimer", admin_settings_ingredient_path(ingredient), method: :delete, data: { turbo_confirm: "Supprimer cet ingrédient ?" }, class: "adm-rowaction", form: { class: "inline" }
        - else
          = adm_empty_row colspan: 6, title: "Aucun ingrédient défini", hint: "Un ingrédient est une garniture ou une matière première, avec son prix au kilo." do
            = link_to "Nouvel ingrédient", new_admin_settings_ingredient_path, class: adm_btn_class(:primary)
