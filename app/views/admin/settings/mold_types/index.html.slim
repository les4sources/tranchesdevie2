- content_for :title, "Types de moules"
- content_for :layout, "admin"

= adm_page_header "Types de moules" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_mold_type_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouveau type

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Tous les types de moules
    span.adm-eyebrow = "#{@mold_types.size} type#{'s' if @mold_types.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th.text-right Position
          th Nom
          th.text-right Limite
          th.text-right Variantes
          th Actions
      tbody
        - if @mold_types.any?
          - @mold_types.each do |mold_type|
            tr
              td.adm-grid-num.text-right = mold_type.position
              td.font-medium style="color: var(--text-strong);" = mold_type.name
              td.adm-grid-num.text-right = mold_type.limit
              td.adm-grid-num.text-right = mold_type.product_variants.count
              td.whitespace-nowrap
                = link_to "Modifier", edit_admin_settings_mold_type_path(mold_type), class: "adm-rowaction mr-3"
                = button_to "Supprimer", admin_settings_mold_type_path(mold_type), method: :delete, data: { turbo_confirm: "Supprimer ce type de moule ?" }, class: "adm-rowaction", form: { class: "inline" }
        - else
          = adm_empty_row colspan: 5, title: "Aucun type de moule défini", hint: "La limite d'un type de moule borne ce qu'on peut enfourner sur un jour de cuisson." do
            = link_to "Nouveau type", new_admin_settings_mold_type_path, class: adm_btn_class(:primary)
