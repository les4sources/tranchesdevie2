- content_for :title, "Notifications"
- content_for :layout, "admin"

= adm_page_header "Notifications" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)

= form_with model: [:admin, :settings, @notification_setting], url: admin_settings_notification_setting_path, method: :patch, local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if @notification_setting.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - @notification_setting.errors.full_messages.each do |message|
          li= message

  .adm-panel.p-4.text-sm style="color: var(--text-body);"
    p
      | Ce message est envoyé au client quand les boulangers marquent sa commande « prête ». Le même texte part
      strong> &nbsp;par SMS et par email.
    p.mt-2
      | Variables disponibles (remplacées automatiquement) :
      - NotificationSetting::AVAILABLE_VARIABLES.each do |var|
        code.mx-1.rounded.border.px-1.5.py-0.5 style="border-color: var(--border-subtle); background: var(--surface-card);" ="{#{var}}"
    p.mt-1.text-xs style="color: var(--text-muted);" prenom · nom · montant (total à payer) · numero (n° de commande)

  .space-y-2
    = f.label :ready_sms_body, "Message — commande prête (payée)", class: "adm-eyebrow block"
    = f.text_area :ready_sms_body, rows: 4, class: adm_field_class
    p.text-xs style="color: var(--text-muted);" Envoyé quand la commande est déjà payée.

  .space-y-2
    = f.label :ready_sms_body_unpaid, "Message — commande prête (à payer sur place)", class: "adm-eyebrow block"
    = f.text_area :ready_sms_body_unpaid, rows: 5, class: adm_field_class
    p.text-xs style="color: var(--text-muted);" Envoyé quand la commande n'est pas encore payée. Pense à garder <code>{montant}</code> pour indiquer le total.

  .space-y-2
    = f.label :ready_email_subject, "Objet de l'email", class: "adm-eyebrow block"
    = f.text_field :ready_email_subject, class: adm_field_class
    p.text-xs style="color: var(--text-muted);" Objet de l'email « commande prête » (le corps reprend le message ci-dessus).

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_path, class: adm_btn_class(:ghost)
    = f.submit "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
