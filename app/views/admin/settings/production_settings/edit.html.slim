- content_for :title, "Capacités de production"
- content_for :layout, "admin"

= adm_page_header "Capacités de production" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)

= form_with model: [:admin, :settings, @production_setting], url: admin_settings_production_setting_path, method: :patch, local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if @production_setting.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - @production_setting.errors.full_messages.each do |message|
          li= message

  h2.text-sm.font-semibold style="color: var(--text-strong);" Capacité du four
  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .space-y-2
      = f.label :oven_capacity_grams, "Jour normal (grammes)", class: "adm-eyebrow block"
      = f.number_field :oven_capacity_grams, min: 1, class: adm_field_class
      p.text-xs style="color: var(--text-muted);" = "#{(@production_setting.oven_capacity_grams / 1000.0).round(1)} kg"
    .space-y-2
      = f.label :market_day_oven_capacity_grams, "Jour de marché (grammes)", class: "adm-eyebrow block"
      = f.number_field :market_day_oven_capacity_grams, min: 1, class: adm_field_class
      p.text-xs style="color: var(--text-muted);" = "#{(@production_setting.market_day_oven_capacity_grams / 1000.0).round(1)} kg"
    .space-y-2
      = f.label :private_party_slot_capacity, "Parties privées par créneau", class: "adm-eyebrow block"
      = f.number_field :private_party_slot_capacity, min: 1, class: adm_field_class
      p.text-xs style="color: var(--text-muted);" Nombre max de parties privées réservables sur un même créneau (midi/soir).

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_path, class: adm_btn_class(:ghost)
    = f.submit "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
