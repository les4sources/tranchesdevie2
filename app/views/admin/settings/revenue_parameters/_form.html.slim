- key = revenue_parameter.key
- is_transport = key == RevenueParameter::TRANSPORT
- unit_label = is_transport ? "Montant (€ / jour de production)" : "Taux (%)"
/ Le taux ateliers (#208) porte sur la RECETTE, pas sur une marge brute : un
/ atelier n'a ni coûtant, ni sacs, ni transport à déduire.
- is_workshop_rate = revenue_parameter.key == RevenueParameter::WORKSHOP_FOUR_SOURCES_RATE
- current_input = revenue_parameter.persisted? ? number_with_precision(revenue_parameter.value / 100.0, strip_insignificant_zeros: true) : nil

= form_with model: revenue_parameter, url: (revenue_parameter.persisted? ? admin_settings_revenue_parameter_path(revenue_parameter) : admin_settings_revenue_parameters_path), method: (revenue_parameter.persisted? ? :patch : :post), local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if revenue_parameter.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - revenue_parameter.errors.full_messages.each do |message|
          li= message

  = f.hidden_field :key, value: key

  .grid.grid-cols-1.md:grid-cols-2.gap-6
    .space-y-2
      = f.label :value_input, unit_label, class: "adm-eyebrow block"
      = f.text_field :value_input, value: current_input, inputmode: "decimal", required: true, class: adm_field_class
      - if is_workshop_rate
        p.text-xs style="color: var(--text-muted);"
          | Part des 4 Sources sur la RECETTE d'un atelier — pas sur une marge brute : un atelier n'a ni coûtant matière, ni sacs, ni transport à déduire. Tant qu'aucun palier n'est saisi, les recettes d'atelier ne sont réparties à personne.
    .space-y-2
      = f.label :active_from, "À partir du", class: "adm-eyebrow block"
      = f.date_field :active_from, class: adm_field_class

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_revenue_parameters_path, class: adm_btn_class(:ghost)
    = f.submit revenue_parameter.persisted? ? "Mettre à jour" : "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
