- content_for :title, "Revenus boulangers — paramètres"
- content_for :layout, "admin"

- labels = { RevenueParameter::TRANSPORT => "Transport (par jour de production)", RevenueParameter::FOUR_SOURCES_RATE => "Taux Les 4 Sources (sur la marge brute)", RevenueParameter::WORKSHOP_FOUR_SOURCES_RATE => "Taux Les 4 Sources sur les ateliers (sur la recette)" }
- units = { RevenueParameter::TRANSPORT => "€ / jour", RevenueParameter::FOUR_SOURCES_RATE => "%" }

= adm_page_header "Revenus des boulangers" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)

p.-mt-2.mb-4.text-sm style="color: var(--text-muted);"
  | Paramètres généraux du calcul des revenus des boulangers, historisés par date : un nouveau palier ne modifie pas les périodes antérieures.

- RevenueParameter::KEYS.each do |key|
  section.adm-card.mb-4.overflow-hidden
    .adm-cardhd
      h2.text-sm.font-semibold style="color: var(--text-strong);" = labels[key]
      = link_to "Ajouter un palier", new_admin_settings_revenue_parameter_path(key: key), class: adm_btn_class(:default)

    - paliers = @parameters_by_key[key]
    .overflow-x-auto
      table.adm-grid
        thead
          tr
            th.text-right Valeur
            th À partir du
            th Actions
        tbody
          - if paliers.any?
            - paliers.each do |param|
              tr
                td.adm-grid-num.text-right.font-medium style="color: var(--text-strong);"
                  - if key == RevenueParameter::TRANSPORT
                    = number_to_currency(param.value / 100.0, unit: "€", separator: ",", delimiter: "") + " " + units[key].sub("€ / ", "/ ")
                  - else
                    = "#{number_with_precision(param.value / 100.0, strip_insignificant_zeros: true)} %"
                td = l(param.active_from)
                td.whitespace-nowrap
                  = link_to "Modifier", edit_admin_settings_revenue_parameter_path(param), class: "adm-rowaction mr-3"
                  = link_to "Supprimer", admin_settings_revenue_parameter_path(param), data: { turbo_method: :delete, turbo_confirm: "Supprimer ce palier ?" }, class: "adm-rowaction"
          - else
            = adm_empty_row colspan: 3, title: "Aucun palier saisi", hint: "La référence (#{key == RevenueParameter::TRANSPORT ? '15 €/jour' : '30 %'}) est utilisée par défaut." do
              = link_to "Ajouter un palier", new_admin_settings_revenue_parameter_path(key: key), class: adm_btn_class(:primary)
