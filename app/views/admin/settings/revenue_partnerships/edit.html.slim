- content_for :title, "Modifier le partenariat"
- content_for :layout, "admin"

= adm_page_header "Partenariat : #{@partnership.name}" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to "Partenariats", admin_settings_revenue_partnerships_path, class: adm_btn_class(:ghost)

.adm-card.max-w-2xl.p-4.sm:p-6
  = render "form",
    partnership: @partnership,
    form_url: admin_settings_revenue_partnership_path(@partnership),
    form_method: :patch,
    submit_label: "Enregistrer",
    eligible_artisans: eligible_artisans(@partnership)
