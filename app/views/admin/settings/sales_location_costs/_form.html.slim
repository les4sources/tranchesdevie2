= form_with model: cost, url: (cost.persisted? ? admin_settings_sales_location_sales_location_cost_path(@sales_location, cost) : admin_settings_sales_location_sales_location_costs_path(@sales_location)), method: (cost.persisted? ? :patch : :post), local: true, class: "adm-card space-y-6 p-4 sm:p-6" do |f|
  - if cost.errors.any?
    .adm-card.p-4 style="border-color: var(--danger-200); background: var(--danger-100);"
      h2.text-sm.font-semibold style="color: var(--danger-700);" Correction requise
      ul.mt-2.list-inside.list-disc.text-sm style="color: var(--danger-700);"
        - cost.errors.full_messages.each do |message|
          li= message

  .grid.grid-cols-1.md:grid-cols-3.gap-6
    .space-y-2
      = f.label :amount_euros, "Coût (€)", class: "adm-eyebrow block"
      = f.number_field :amount_euros, value: cost.amount_euros, step: "0.01", min: 0, required: true, class: adm_field_class
    .space-y-2
      = f.label :valid_from, "À partir du", class: "adm-eyebrow block"
      = f.date_field :valid_from, required: true, class: adm_field_class
    .space-y-2
      = f.label :valid_until, "Jusqu'au (optionnel)", class: "adm-eyebrow block"
      = f.date_field :valid_until, class: adm_field_class

  .flex.flex-wrap.items-center.justify-end.gap-3
    = link_to "Annuler", admin_settings_sales_location_sales_location_costs_path(@sales_location), class: adm_btn_class(:ghost)
    = f.submit cost.persisted? ? "Mettre à jour" : "Enregistrer", class: adm_btn_class(:primary, "cursor-pointer")
