- content_for :title, "Coûts — #{@sales_location.name}"
- content_for :layout, "admin"

= adm_page_header "Coûts : #{@sales_location.name}" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to "Lieux de vente", admin_settings_sales_locations_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_sales_location_sales_location_cost_path(@sales_location), class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Ajouter un palier

p.-mt-2.mb-4.text-sm style="color: var(--text-muted);"
  | Coût de l'emplacement, historisé par période de validité. Le coût appliqué à une fournée est celui de la période qui couvre sa date de cuisson. Une période sans date de fin est en cours.

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Paliers de coût
    span.adm-eyebrow = "#{@costs.size} palier#{'s' if @costs.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th.text-right Coût
          th À partir du
          th Jusqu'au
          th Actions
      tbody
        - if @costs.any?
          - @costs.each do |cost|
            tr
              td.adm-grid-num.text-right.font-medium style="color: var(--text-strong);" = number_to_currency(cost.amount_euros, unit: "€", format: "%n %u", separator: ",", delimiter: " ")
              td = l(cost.valid_from)
              td
                - if cost.valid_until
                  = l(cost.valid_until)
                - else
                  = adm_chip "En cours", tone: :success
              td.whitespace-nowrap
                = link_to "Modifier", edit_admin_settings_sales_location_sales_location_cost_path(@sales_location, cost), class: "adm-rowaction mr-3"
                = link_to "Supprimer", admin_settings_sales_location_sales_location_cost_path(@sales_location, cost), data: { turbo_method: :delete, turbo_confirm: "Supprimer ce palier ?" }, class: "adm-rowaction"
        - else
          = adm_empty_row colspan: 4, title: "Aucun coût saisi", hint: "Sans coût configuré, ce lieu ne déduit rien du bénéfice." do
            = link_to "Ajouter un palier", new_admin_settings_sales_location_sales_location_cost_path(@sales_location), class: adm_btn_class(:primary)
