- content_for :title, "Nouveau coût"
- content_for :layout, "admin"

= adm_page_header "Nouveau coût" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to "Lieux de vente", admin_settings_sales_locations_path, class: adm_btn_class(:ghost)
  = link_to @sales_location.name, admin_settings_sales_location_sales_location_costs_path(@sales_location), class: adm_btn_class(:ghost)

= render "form", cost: @cost
