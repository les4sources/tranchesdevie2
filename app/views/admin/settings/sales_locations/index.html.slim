- content_for :title, "Lieux de vente"
- content_for :layout, "admin"

= adm_page_header "Lieux de vente" do
  = link_to "Paramètres", admin_settings_path, class: adm_btn_class(:ghost)
  = link_to new_admin_settings_sales_location_path, class: adm_btn_class(:primary) do
    = lucide "plus", size: 15
    |  Nouveau lieu de vente

p.-mt-2.mb-4.text-sm style="color: var(--text-muted);"
  | Un lieu de vente (ex. un marché) porte un coût d'emplacement, déduit du bénéfice des fournées qui y sont vendues. Concept distinct des points de retrait.

.adm-card.overflow-hidden
  .adm-cardhd
    h2.text-sm.font-semibold style="color: var(--text-strong);" Tous les lieux de vente
    span.adm-eyebrow = "#{@sales_locations.size} lieu#{'x' if @sales_locations.size > 1}"

  .overflow-x-auto
    table.adm-grid
      thead
        tr
          th Nom
          th Actif
          th.text-right Coût actuel
          th Actions
      tbody
        - if @sales_locations.any?
          - @sales_locations.each do |location|
            tr
              td.font-medium style="color: var(--text-strong);" = location.name
              td
                - if location.active?
                  = adm_chip "Oui", tone: :success
                - else
                  = adm_chip "Inactif", tone: :neutral
              td.adm-grid-num.text-right
                - current_cost = location.cost_cents
                - if current_cost
                  = number_to_currency(current_cost / 100.0, unit: "€", format: "%n %u", separator: ",", delimiter: " ")
                - else
                  span style="color: var(--text-faint);" —
              td.whitespace-nowrap
                = link_to "Modifier", edit_admin_settings_sales_location_path(location), class: "adm-rowaction mr-3"
                = link_to "Coûts", admin_settings_sales_location_sales_location_costs_path(location), class: "adm-rowaction mr-3"
                = link_to "Supprimer", admin_settings_sales_location_path(location), data: { turbo_method: :delete, turbo_confirm: "Supprimer ce lieu de vente ?" }, class: "adm-rowaction"
        - else
          = adm_empty_row colspan: 4, title: "Aucun lieu de vente enregistré", hint: "Un lieu de vente porte un coût d'emplacement, déduit du bénéfice des fournées qui y sont vendues." do
            = link_to "Nouveau lieu de vente", new_admin_settings_sales_location_path, class: adm_btn_class(:primary)
