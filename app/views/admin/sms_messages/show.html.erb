<% content_for :title, "Détails du SMS - #{@customer.full_name}" %>
<% content_for :layout, "admin" %>

<%= adm_page_header "Détails du message SMS" %>

<div class="adm-card p-4 sm:p-6">
  <h2 class="mb-4 text-xl font-semibold" style="color: var(--text-strong);">Informations</h2>

  <dl class="space-y-3">
    <div>
      <dt class="adm-eyebrow">Client</dt>
      <dd class="mt-1 text-sm">
        <%= link_to @customer.full_name, admin_customer_path(@customer), class: "adm-link" %>
      </dd>
      <% if @customer.phone_e164.present? %>
        <dd class="adm-grid-num text-sm" style="color: var(--text-muted);"><%= @customer.phone_e164 %></dd>
      <% else %>
        <dd class="text-sm italic" style="color: var(--text-faint);">Non renseigné</dd>
      <% end %>
    </div>

    <div>
      <dt class="adm-eyebrow">Date d'envoi</dt>
      <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);">
        <%= (@sms_message.sent_at || @sms_message.created_at).strftime("%d/%m/%Y à %H:%M:%S") %>
      </dd>
    </div>

    <div>
      <dt class="adm-eyebrow">Type</dt>
      <dd class="mt-1"><%= adm_message_kind_chip(@sms_message.kind) %></dd>
    </div>

    <div>
      <dt class="adm-eyebrow">Direction</dt>
      <dd class="mt-1"><%= adm_message_direction_chip(@sms_message.outbound?) %></dd>
    </div>

    <div>
      <dt class="adm-eyebrow">Destinataire</dt>
      <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @sms_message.to_e164 %></dd>
    </div>

    <div>
      <dt class="adm-eyebrow">Expéditeur</dt>
      <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @sms_message.from_e164 %></dd>
    </div>

    <% if @sms_message.external_id.present? %>
      <div>
        <dt class="adm-eyebrow">ID externe (Smstools)</dt>
        <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @sms_message.external_id %></dd>
      </div>
    <% end %>

    <% if @sms_message.baked_on.present? %>
      <div>
        <dt class="adm-eyebrow">Jour de cuisson</dt>
        <dd class="adm-grid-num mt-1 text-sm" style="color: var(--text-strong);"><%= @sms_message.baked_on.strftime("%d/%m/%Y") %></dd>
      </div>
    <% end %>
  </dl>
</div>

<div class="adm-card mt-4 p-4 sm:p-6">
  <h2 class="mb-4 text-xl font-semibold" style="color: var(--text-strong);">Contenu du message</h2>
  <div class="rounded-md p-4" style="background: var(--surface-inset);">
    <p class="whitespace-pre-wrap text-sm" style="color: var(--text-strong);"><%= @sms_message.body %></p>
  </div>
</div>

<div class="mt-4">
  <%= link_to "← Retour au mangeur", admin_customer_path(@customer), class: "adm-link" %>
</div>
