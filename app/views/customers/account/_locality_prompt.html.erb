<%# Encart « D'où viens-tu ? » (retour Michael 19/10/2026) : demande le village
    du client, facultatif, tant qu'il est inconnu et que le client n'a pas
    préféré ne pas répondre. Affiché dans « Mon compte » et après une commande.
    `css` : classes du conteneur selon la page. %>
<% if customer_signed_in? && current_customer.locality_prompt? %>
  <div class="<%= local_assigns.fetch(:css, "mb-7") %> rounded-lg border border-sage-200 bg-sage-100/60 p-5 text-left" data-locality-prompt>
    <div class="flex items-start gap-3">
      <span class="mt-0.5 flex-shrink-0"><%= lucide "map-pin", size: 20, color: "var(--sage-700)" %></span>
      <div class="min-w-0 flex-1">
        <h2 class="font-script text-2xl font-bold leading-tight text-ink-900">D'où viens-tu ?</h2>
        <p class="mt-0.5 text-sm text-ink-700">Dis-nous dans quel village tu habites : ça nous aide à savoir d'où viennent nos mangeurs. Seule l'équipe de la boulangerie le voit.</p>

        <%= form_with url: customers_account_locality_path, method: :patch, local: true, class: "mt-3 flex flex-wrap items-center gap-2" do |f| %>
          <%= f.text_field :locality,
              list: "locality-suggestions",
              placeholder: "Ex. Godinne",
              autocomplete: "address-level2",
              maxlength: 80,
              required: true,
              "aria-label": "Ton village",
              class: "h-10 w-full min-w-0 flex-1 rounded-md border border-flour-400 bg-white px-3 text-[15px] text-ink-900 focus:border-sage-600 focus:outline-none focus:ring-[3px] focus:ring-[color:var(--focus-ring)] sm:max-w-xs" %>
          <%= f.submit "Enregistrer", class: "h-10 cursor-pointer rounded-md bg-sage-600 px-4 text-sm font-semibold text-white shadow-xs transition hover:bg-sage-500" %>
        <% end %>
        <%= render "customers/account/locality_datalist" %>

        <%= button_to "Je préfère ne pas répondre", customers_account_locality_path,
              method: :patch, params: { dismiss: 1 }, form: { class: "mt-2" },
              class: "cursor-pointer text-[13px] font-medium text-ink-500 underline underline-offset-2 hover:text-ink-700" %>
      </div>
    </div>
  </div>
<% end %>
