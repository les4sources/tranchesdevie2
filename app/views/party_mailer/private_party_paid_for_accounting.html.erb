<% content_for :title, "Pizza Party privée payée" %>

<h1 style="margin:0 0 8px 0; font-family:Georgia,'Times New Roman',serif; font-size:22px; color:#7c2d12;">
  Pizza Party privée payée
</h1>

<p style="margin:0 0 24px 0; color:#6b6259;">
  Le paiement de cette Pizza Party privée vient d'être encaissé. Si le groupe est
  aussi hébergé aux 4 Sources, pensez à la reporter sur la facture du séjour.
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-collapse:collapse; margin:0 0 24px 0;">
  <% rows = [
       [ "Date", I18n.l(@party_event.held_on, format: :long_with_day) ],
       [ "Créneau", @party_event.slot_label ],
       [ "Groupe", @party_request&.group_name.presence || "—" ],
       [ "Nombre de personnes", "#{@paton_count} personne#{'s' if @paton_count > 1} (#{@paton_count} pâton#{'s' if @paton_count > 1})" ],
       [ "Forfait", @party_request.nil? ? "—" : (@party_request.forfait? ? "Oui" : "Non") ],
       [ "Remarque du client", @party_request&.customer_note.presence || "—" ],
       [ "Client", @customer.full_name ],
       [ "E-mail", @customer.email.presence || "—" ],
       [ "Téléphone", @customer.phone_e164.presence || "—" ],
       [ "Commande", @order.order_number ]
     ] %>
  <% rows.each do |label, value| %>
    <tr>
      <td style="padding:10px 0; border-bottom:1px solid #ece4d8; color:#8a8178; width:190px; vertical-align:top;"><%= label %></td>
      <td style="padding:10px 0; border-bottom:1px solid #ece4d8;"><%= value %></td>
    </tr>
  <% end %>
</table>

<h2 style="margin:0 0 8px 0; font-family:Georgia,'Times New Roman',serif; font-size:17px; color:#7c2d12;">
  Détail
</h2>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-collapse:collapse; margin:0 0 24px 0;">
  <% @order.order_items.includes(product_variant: :product).each do |item| %>
    <tr>
      <td style="padding:8px 0; border-bottom:1px solid #ece4d8;"><%= item.full_name %></td>
      <td style="padding:8px 0; border-bottom:1px solid #ece4d8; text-align:right; white-space:nowrap;">
        <%= item.qty %> × <%= number_to_currency(item.unit_price_euros, unit: "€", separator: ",", delimiter: "") %>
        = <%= number_to_currency(item.subtotal_euros, unit: "€", separator: ",", delimiter: "") %>
      </td>
    </tr>
  <% end %>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-collapse:collapse; margin:0 0 24px 0;">
  <tr>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8; color:#8a8178; width:190px;">Montant total payé</td>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8; font-weight:bold;">
      <%= number_to_currency(@order.total_euros, unit: "€", separator: ",", delimiter: "") %>
    </td>
  </tr>
  <tr>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8; color:#8a8178;">Moyen de paiement</td>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8; font-weight:bold;"><%= @payment_method_label %></td>
  </tr>
  <tr>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8; color:#8a8178;">Date de paiement</td>
    <td style="padding:10px 0; border-bottom:1px solid #ece4d8;">
      <%= @order.paid_at ? I18n.l(@order.paid_at.in_time_zone("Europe/Brussels"), format: :long) : "—" %>
    </td>
  </tr>
  <tr>
    <td style="padding:10px 0; color:#8a8178;">Facture demandée</td>
    <td style="padding:10px 0; font-weight:bold;"><%= @order.requires_invoice? ? "Oui" : "Non" %></td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px 0;">
  <tr>
    <td style="background-color:#7c2d12; border-radius:8px;">
      <a href="<%= @admin_party_event_url %>"
         style="display:inline-block; padding:12px 22px; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none;">
        Voir la Pizza Party dans l'admin
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 4px 0; font-size:13px; color:#8a8178;">
  <%= @admin_party_event_url %>
</p>

<p style="margin:0; font-size:13px; color:#8a8178;">
  Voir la commande : <a href="<%= @admin_order_url %>" style="color:#7c2d12;"><%= @admin_order_url %></a>
</p>
