<% content_for :title, "Confirmer et régler ma Pizza Party" %>

<div class="mx-auto max-w-[680px] px-6 py-12">
  <div class="rounded-2xl border border-flour-300 bg-warm-white p-8 shadow-xs">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-400">Pizza Party privée</p>
    <h1 class="mt-1 font-script text-[34px] font-bold leading-tight text-ink-900">
      <%= I18n.l(@order.party_event.held_on, format: :long_with_day).capitalize %>
    </h1>
    <p class="mt-1 text-sm text-ink-500">
      Soir · à régler avant le
      <b class="font-semibold text-ink-900"><%= I18n.l(@order.payment_due_at.in_time_zone("Europe/Brussels"), format: :long) %></b>
    </p>

    <div data-controller="party-payment"
         data-party-payment-url-value="<%= party_payment_intent_path(token: @order.public_token) %>"
         data-party-payment-return-value="<%= party_payment_success_url(token: @order.public_token) %>"
         data-party-payment-key-value="<%= @stripe_public_key %>"
         data-party-payment-unit-value="<%= @variant_price_cents %>"
         data-party-payment-forfait-value="<%= @forfait_cents %>">

      <div class="mt-7 border-t border-flour-300 pt-6">
        <h2 class="text-[22px] font-semibold text-ink-900">Combien serez-vous exactement&nbsp;?</h2>
        <p class="mt-1 text-sm leading-relaxed text-ink-600">
          Un pâton au levain par personne. C'est ce nombre qui sera préparé par les boulangères.
        </p>

        <div class="mt-4 flex items-center gap-3">
          <button type="button" data-action="click->party-payment#decrement"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-flour-400 text-ink-700 transition hover:bg-flour-100">
            <%= lucide "minus", size: 18, color: "var(--ink-700)" %>
          </button>
          <input type="number" min="1" value="<%= @persons %>"
                 data-party-payment-target="persons"
                 data-action="input->party-payment#recalculate"
                 class="h-11 w-24 rounded-md border border-flour-400 bg-white text-center text-lg font-semibold text-ink-900 focus:border-sage-600 focus:outline-none">
          <button type="button" data-action="click->party-payment#increment"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-flour-400 text-ink-700 transition hover:bg-flour-100">
            <%= lucide "plus", size: 18, color: "var(--ink-700)" %>
          </button>
          <span class="text-sm text-ink-500">personnes</span>
        </div>
      </div>

      <dl class="mt-6 space-y-2 rounded-xl border border-flour-300 bg-flour-50 px-5 py-4 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-ink-700">Pâtons (<span data-party-payment-target="countLabel"><%= @persons %></span> × <%= number_to_currency(@variant_price_cents / 100.0, unit: "€", separator: ",", delimiter: "") %>)</dt>
          <dd class="font-medium text-ink-900" data-party-payment-target="patonsLabel"></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-ink-700">Forfait (préparation, bois, matériel)</dt>
          <dd class="font-medium text-ink-900"><%= number_to_currency(@forfait_cents / 100.0, unit: "€", separator: ",", delimiter: "") %></dd>
        </div>
        <div class="flex items-center justify-between border-t border-flour-300 pt-2 text-base">
          <dt class="font-semibold text-ink-900">Total</dt>
          <dd class="font-semibold text-ink-900" data-party-payment-target="totalLabel"></dd>
        </div>
      </dl>

      <div class="mt-6">
        <div data-party-payment-target="paymentElement" class="min-h-[40px]"></div>

        <button type="button" data-action="click->party-payment#submit"
                data-party-payment-target="submit"
                class="mt-5 flex h-12 w-full items-center justify-center gap-2 rounded-md bg-ember-600 px-4 text-base font-semibold text-white shadow-xs transition hover:bg-ember-500 disabled:cursor-not-allowed disabled:opacity-50">
          <%= lucide "lock", size: 18, color: "#fff" %> <span data-party-payment-target="submitLabel">Régler ma réservation</span>
        </button>

        <p class="mt-3 hidden text-sm text-danger-700" data-party-payment-target="message"></p>
        <p class="mt-3 text-center text-xs text-ink-500">
          Carte, Bancontact, Apple Pay ou Google Pay. Paiement sécurisé par Stripe.
        </p>
      </div>
    </div>
  </div>
</div>
