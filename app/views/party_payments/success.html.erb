<% content_for :title, "Pizza Party confirmée" %>

<div class="mx-auto max-w-[680px] px-6 py-16">
  <div class="rounded-2xl border border-flour-300 bg-warm-white p-8 text-center shadow-xs sm:p-10">
    <% if @order.awaiting_payment? %>
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-flour-100">
        <%= lucide "hourglass", size: 26, color: "var(--ink-500)" %>
      </div>
      <h1 class="mt-5 font-script text-[34px] font-bold leading-tight text-ink-900">Paiement en cours de traitement</h1>
      <p class="mt-3 text-[17px] leading-relaxed text-ink-700">
        Ta banque n'a pas encore confirmé le paiement. Dès qu'il aboutit, ta Pizza party est
        confirmée et tu reçois un e-mail — inutile de régler une seconde fois.
      </p>
    <% else %>
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-sage-100">
        <%= lucide "party-popper", size: 26, color: "var(--sage-700)" %>
      </div>
      <h1 class="mt-5 font-script text-[36px] font-bold leading-tight text-ink-900">Ta Pizza Party est confirmée&nbsp;!</h1>
      <p class="mt-3 text-[17px] leading-relaxed text-ink-700">
        Rendez-vous le
        <b class="font-semibold text-ink-900"><%= I18n.l(@order.party_event.held_on, format: :long_with_day) %></b>
        au fournil. Les boulangères prépareront
        <b class="font-semibold text-ink-900"><%= @order.party_paton_count %> pâton<%= "s" if @order.party_paton_count > 1 %></b>.
      </p>
      <p class="mt-3 text-sm text-ink-600">
        N'oublie pas tes garnitures : passata, légumes, fromages… Un récapitulatif t'attend par e-mail.
      </p>
    <% end %>

    <%= link_to catalog_path, class: "mt-7 inline-flex items-center gap-2 rounded-md border border-flour-400 px-5 py-2.5 text-sm font-semibold text-ink-700 transition hover:bg-flour-100" do %>
      Retour à la boutique
    <% end %>
  </div>
</div>
